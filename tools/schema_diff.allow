-^IF v_lines > 0 AND v_all THEN UPDATE fleet\.service_order SET status = 'parts_reserved' WHERE id = v_so;
-^IF v_qty < v_line\.qty_required THEN v_all := false;
-^IF v_qty > 0 THEN INSERT INTO inventory\.stock_reservation .*VALUES \(v_wh, v_line\.part_id, v_qty, 'soft', now\(\)
-^SELECT b\.available_qty INTO v_avail FROM inventory\.stock_balance b WHERE b\.warehouse_id = v_wh AND b\.part_id = v_line\.part_id FOR UPDATE;
-^v_qty := least\(coalesce\(v_avail, 0\), v_line\.qty_required\);
-^v_(all|avail|line|lines|qty) +(boolean := true|numeric|record|integer := 0);$
