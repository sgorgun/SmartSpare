+issue_service_kit
+^GRANT UPDATE\(qty_issued\) ON TABLE fleet\.service_order_line TO app_write;$
+^IF v_done IS NOT NULL THEN -- Issued before: release a late hold
+^IF v_qty > 0 THEN INSERT INTO inventory\.stock_movement .*'ISSUE_SERVICE', v_qty, p\.unit_cost, v_line\.line_id, v_user
+^PERFORM 1 FROM inventory\.stock_balance b WHERE b\.warehouse_id = p_warehouse_id AND b\.part_id = ANY \(p_part_ids\) ORDER BY b\.part_id, b\.warehouse_id FOR UPDATE;$
+^UPDATE inventory\.stock_reservation r SET status = 'consumed' WHERE r\.service_order_line_id = v_line\.line_id
+^issued_qty := (greatest\(v_qty, 0\)|v_done);$
+^shortfall_qty := (greatest\(v_line\.quantity - v_done, 0\)|v_line\.quantity - greatest\(v_qty, 0\));$
+^v_done +numeric;$


