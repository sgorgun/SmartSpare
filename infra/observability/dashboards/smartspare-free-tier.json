{
  "uid": "smartspare-free-tier",
  "title": "SmartSpare free-tier usage",
  "description": "Active series against the 10k of Grafana Cloud Free; locally Prometheus' own head series (ADR 0018 section 5).",
  "tags": [
    "smartspare"
  ],
  "timezone": "utc",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "editable": true,
  "panels": [
    {
      "type": "timeseries",
      "title": "Active series",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(grafanacloud_instance_active_series or prometheus_tsdb_head_series)",
          "legendFormat": "active series"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Series by service",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count by (job) ({__name__=~\".+\", job!=\"\"})",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
