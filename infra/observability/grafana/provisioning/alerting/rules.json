{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "smartspare-http",
      "folder": "SmartSpare",
      "interval": "1m",
      "rules": [
        {
          "uid": "ss-http-5xx",
          "title": "5xx rate per service",
          "condition": "C",
          "for": "5m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "warning",
            "system": "smartspare"
          },
          "annotations": {
            "summary": "More than 2 % of {{ $labels.job }}'s requests failed with 5xx for 5 minutes."
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "sum by (job) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[5m])) / clamp_min(sum by (job) (rate(http_server_request_duration_seconds_count[5m])), 1e-9)",
                "instant": true
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.02
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "ss-http-p95",
          "title": "p95 latency per service",
          "condition": "C",
          "for": "10m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "warning",
            "system": "smartspare"
          },
          "annotations": {
            "summary": "p95 latency of {{ $labels.job }} above 2 s for 10 minutes (NFR01)."
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_server_request_duration_seconds_bucket[10m])))",
                "instant": true
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        2
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "orgId": 1,
      "name": "smartspare-messaging",
      "folder": "SmartSpare",
      "interval": "1m",
      "rules": [
        {
          "uid": "ss-outbox-lag",
          "title": "Outbox lag",
          "condition": "C",
          "for": "1m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "warning",
            "system": "smartspare"
          },
          "annotations": {
            "summary": "An integration event of {{ $labels.schema }} has waited more than 5 minutes for delivery."
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "max by (job, schema) (smartspare_outbox_oldest_pending_age_seconds)",
                "instant": true
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        300
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "ss-dead-letters",
          "title": "Dead letters",
          "condition": "C",
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "warning",
            "system": "smartspare"
          },
          "annotations": {
            "summary": "{{ $labels.queue }} holds dead-lettered messages."
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "sum by (queue) (smartspare_broker_dead_letter_messages)",
                "instant": true
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "ss-queued",
          "title": "Queued messages",
          "condition": "C",
          "for": "5m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "warning",
            "system": "smartspare"
          },
          "annotations": {
            "summary": "More than 5,000 messages are queued (the free broker holds 10,000)."
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "sum(smartspare_broker_queue_messages)",
                "instant": true
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        5000
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "ss-quota",
          "title": "Monthly message quota",
          "condition": "C",
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "warning",
            "system": "smartspare"
          },
          "annotations": {
            "summary": "More than 70 % of the broker's 1 M monthly messages are used."
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "max(smartspare_broker_published_messages_month)",
                "instant": true
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        700000
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "orgId": 1,
      "name": "smartspare-platform",
      "folder": "SmartSpare",
      "interval": "5m",
      "rules": [
        {
          "uid": "ss-active-series",
          "title": "Active series",
          "condition": "C",
          "for": "15m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "warning",
            "system": "smartspare"
          },
          "annotations": {
            "summary": "Active series above 80 % of the free tier's 10k."
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 900,
                "to": 0
              },
              "datasourceUid": "usage",
              "model": {
                "refId": "A",
                "expr": "max(grafanacloud_instance_active_series or prometheus_tsdb_head_series)",
                "instant": true
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        8000
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "ss-warmup",
          "title": "Warm-up failed",
          "condition": "C",
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "warning",
            "system": "smartspare"
          },
          "annotations": {
            "summary": "A warm-up call found a service that did not become ready (ADR 0009)."
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "sum(increase(smartspare_gateway_warmup_failures_total[1h]))",
                "instant": true
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
