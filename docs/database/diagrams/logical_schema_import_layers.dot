digraph ER {
  graph [rankdir=LR, splines=true, nodesep=0.35, ranksep=1.1, fontname="Helvetica", label=<<B>SmartSpare — import data layers raw -&gt; staging -&gt; core</B>>, labelloc=t, fontsize=22, pad=0.4];
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [color="#555555", arrowsize=0.8, penwidth=1.0];
  subgraph cluster_raw { label=<<B>raw</B> — Data layer 1 — raw>; style="rounded,filled"; fillcolor="#FFFDE7"; color="#C0A000"; fontsize=14; penwidth=2;
    "raw.demand_history_row" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#C0A000"><TR><TD BGCOLOR="#C0A000" COLSPAN="2"><FONT COLOR="white"><B>demand_history_row</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="import_batch_id">PK FK <B>import_batch_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="line_no">PK <B>line_no</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 6 attributes</FONT></I></TD></TR></TABLE>>];
    "raw.import_batch" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#C0A000"><TR><TD BGCOLOR="#C0A000" COLSPAN="2"><FONT COLOR="white"><B>import_batch</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="uploaded_by">FK uploaded_by</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 11 attributes</FONT></I></TD></TR></TABLE>>];
    "raw.part_catalog_row" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#C0A000"><TR><TD BGCOLOR="#C0A000" COLSPAN="2"><FONT COLOR="white"><B>part_catalog_row</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="import_batch_id">PK FK <B>import_batch_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="line_no">PK <B>line_no</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 8 attributes</FONT></I></TD></TR></TABLE>>];
  }
  subgraph cluster_staging { label=<<B>staging</B> — Data layer 2 — staging>; style="rounded,filled"; fillcolor="#F9FBE7"; color="#9E9D24"; fontsize=14; penwidth=2;
    "staging.demand_history" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#9E9D24"><TR><TD BGCOLOR="#9E9D24" COLSPAN="2"><FONT COLOR="white"><B>demand_history</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="import_batch_id">PK FK <B>import_batch_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="line_no">PK FK <B>line_no</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 8 attributes</FONT></I></TD></TR></TABLE>>];
    "staging.import_error" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#9E9D24"><TR><TD BGCOLOR="#9E9D24" COLSPAN="2"><FONT COLOR="white"><B>import_error</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="import_batch_id">FK import_batch_id*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 4 attributes</FONT></I></TD></TR></TABLE>>];
    "staging.part_catalog" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#9E9D24"><TR><TD BGCOLOR="#9E9D24" COLSPAN="2"><FONT COLOR="white"><B>part_catalog</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="import_batch_id">PK FK <B>import_batch_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="line_no">PK FK <B>line_no</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 9 attributes</FONT></I></TD></TR></TABLE>>];
  }
  subgraph cluster_inventory { label=<<B>inventory</B> — Inventory — stock &amp; transfers>; style="rounded,filled"; fillcolor="#E0F2F1"; color="#00897B"; fontsize=14; penwidth=2;
    "inventory.demand_exception" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#00897B"><TR><TD BGCOLOR="#00897B" COLSPAN="2"><FONT COLOR="white"><B>demand_exception</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="movement_id">PK FK <B>movement_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="movement_occurred_at">PK FK <B>movement_occurred_at</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="flagged_by">FK flagged_by</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 3 attributes</FONT></I></TD></TR></TABLE>>];
    "inventory.stock_balance" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#00897B"><TR><TD BGCOLOR="#00897B" COLSPAN="2"><FONT COLOR="white"><B>stock_balance</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="warehouse_id">PK FK <B>warehouse_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="part_id">PK FK <B>part_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 5 attributes</FONT></I></TD></TR></TABLE>>];
    "inventory.stock_movement" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#00897B"><TR><TD BGCOLOR="#00897B" COLSPAN="2"><FONT COLOR="white"><B>stock_movement</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="occurred_at">PK <B>occurred_at</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="warehouse_id">FK warehouse_id*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="part_id">FK part_id*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="movement_type_code">FK movement_type_code*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="service_order_line_id">FK service_order_line_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="transfer_order_line_id">FK transfer_order_line_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="purchase_order_line_id">FK purchase_order_line_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="import_batch_id">FK import_batch_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_by">FK created_by</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 5 attributes</FONT></I></TD></TR></TABLE>>];
    "inventory.stock_reservation" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#00897B"><TR><TD BGCOLOR="#00897B" COLSPAN="2"><FONT COLOR="white"><B>stock_reservation</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="warehouse_id">FK warehouse_id*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="part_id">FK part_id*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="service_order_line_id">FK service_order_line_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="transfer_order_line_id">FK transfer_order_line_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_by">FK created_by</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 5 attributes</FONT></I></TD></TR></TABLE>>];
    "inventory.transfer_order" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#00897B"><TR><TD BGCOLOR="#00897B" COLSPAN="2"><FONT COLOR="white"><B>transfer_order</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="number">UQnumber*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="from_warehouse_id">FK from_warehouse_id*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="to_warehouse_id">FK to_warehouse_id*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="requested_by">FK requested_by</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="approved_by">FK approved_by</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="dispatched_by">FK dispatched_by</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="received_by">FK received_by</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 8 attributes</FONT></I></TD></TR></TABLE>>];
    "inventory.transfer_order_line" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#00897B"><TR><TD BGCOLOR="#00897B" COLSPAN="2"><FONT COLOR="white"><B>transfer_order_line</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="transfer_order_id">FK transfer_order_id*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="part_id">FK part_id*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 3 attributes</FONT></I></TD></TR></TABLE>>];
    "inventory.warehouse" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#00897B"><TR><TD BGCOLOR="#00897B" COLSPAN="2"><FONT COLOR="white"><B>warehouse</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code">UQcode*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 8 attributes</FONT></I></TD></TR></TABLE>>];
    "inventory.warehouse_part" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#00897B"><TR><TD BGCOLOR="#00897B" COLSPAN="2"><FONT COLOR="white"><B>warehouse_part</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="warehouse_id">PK FK <B>warehouse_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="part_id">PK FK <B>part_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 5 attributes</FONT></I></TD></TR></TABLE>>];
    "inventory.warehouse_route" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#00897B"><TR><TD BGCOLOR="#00897B" COLSPAN="2"><FONT COLOR="white"><B>warehouse_route</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="from_warehouse_id">PK FK <B>from_warehouse_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="to_warehouse_id">PK FK <B>to_warehouse_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 3 attributes</FONT></I></TD></TR></TABLE>>];
  }
  subgraph cluster_catalog { label=<<B>catalog</B> — Inventory — catalogue>; style="rounded,filled"; fillcolor="#E3F2FD"; color="#1E88E5"; fontsize=14; penwidth=2;
    "catalog.part" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#1E88E5"><TR><TD BGCOLOR="#1E88E5" COLSPAN="2"><FONT COLOR="white"><B>part</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="brand_id">FK brand_id*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_id">FK category_id*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="uom_id">FK uom_id*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 8 attributes</FONT></I></TD></TR></TABLE>>];
