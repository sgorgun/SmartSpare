digraph F {
  graph [rankdir=LR, fontname="Helvetica", nodesep=0.35, ranksep=0.7, label=<<B>SmartSpare — data flow through the database layers</B>>, labelloc=t, fontsize=18, pad=0.3];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  csv [label="ERP CSV files\n(catalogue, demand history)", fillcolor="#F5F5F5"];
  ui [label="Users via API\n(engine hours, sales, transfers, POs)", fillcolor="#F5F5F5"];
  raw [label="RAW\nimport_batch (SHA-256)\npart_catalog_row\ndemand_history_row\n(all text, as received)", fillcolor="#FFFDE7", color="#C0A000"];
  stg [label="STAGING\ntyped + normalised rows\nimport_error (REQUIRED, TYPE,\nRANGE, FORMAT, UNKNOWN_REF,\nDUPLICATE) · row_hash", fillcolor="#F9FBE7", color="#9E9D24"];
  gate [label="Quality gate\nerrors ≤ 5 % ?", shape=diamond, fillcolor="#FFFFFF"];
  core [label="CORE (3NF OLTP)\ncatalog.part · stock_movement (ledger)\nstock_balance (triggers) · reservations\nservice / transfer / purchase orders\nforecasts · recommendations", fillcolor="#E0F2F1", color="#00897B"];
  audit [label="AUDIT\nimmutable, 180 days", fillcolor="#ECEFF1", color="#546E7A"];
  mart [label="DATA MART\nmv_weekly_demand\nmv_demand_profile (ADI/CV²)\nv_ml_training_set (lags)\nKPI views · v_data_quality", fillcolor="#E8F5E9", color="#43A047"];
  ml [label="ML.NET training & inference\n(Quartz.NET job)", fillcolor="#E8EAF6", color="#3949AB"];
  kpi [label="Dashboards / reports\nKPI-01..05, accuracy", fillcolor="#F5F5F5"];
  csv -> raw [label=" COPY (API)"];
  raw -> stg [label=" staging.validate_*()"];
  stg -> gate; gate -> core [label=" yes: load_*()\n upsert / new rows only"]; gate -> raw [label=" no: batch 'failed',\n nothing loaded", style=dashed];
  ui -> core [label=" business functions\n (one transaction)"];
  core -> audit [label=" row triggers"];
  core -> mart [label=" mart.refresh_all()\n nightly + after import\n (CONCURRENTLY, refresh_log)"];
  mart -> ml [label=" training set"]; ml -> core [label=" forecast_run, demand_forecast,\n recommendation, model_version"];
  mart -> kpi;
}
