// SmartSpare — logical schema of the OLTP core (PostgreSQL 17)
// GENERATED by tools/generate_editable_diagrams.py from the database catalogue. Do not edit by hand:
// the source of truth are db/migrations/V*.sql. Open at https://dbdiagram.io (Import -> DBML / paste).

Project SmartSpare {
  database_type: 'PostgreSQL'
  Note: '''Agricultural machinery maintenance planning and spare-parts demand forecasting.
  One schema per module of the modular monolith. Business rules (CHECK, triggers, functions),
  partitions, views and roles are documented in docs/database/DATABASE_DESIGN.md.'''
}

Enum fleet.machine_status {
  "active"
  "inactive"
  "decommissioned"
}

Enum fleet.reading_source {
  "manual"
  "telematics"
  "service_visit"
  "import"
}

Enum fleet.service_order_status {
  "draft"
  "parts_reserved"
  "in_progress"
  "completed"
  "cancelled"
}

Enum forecast.forecast_method {
  "zero"
  "ma3"
  "ses"
  "croston"
  "sba"
  "fasttree"
}

Enum forecast.model_status {
  "training"
  "candidate"
  "active"
  "retired"
  "rejected"
}

Enum forecast.recommendation_kind {
  "transfer"
  "purchase"
}

Enum forecast.recommendation_status {
  "open"
  "accepted"
  "overridden"
  "rejected"
  "expired"
}

Enum forecast.run_status {
  "running"
  "succeeded"
  "failed"
}

Enum inventory.reservation_status {
  "soft"
  "firm"
  "consumed"
  "released"
  "expired"
}

Enum inventory.transfer_status {
  "proposed"
  "approved"
  "dispatched"
  "received"
  "cancelled"
}

Enum procurement.po_status {
  "draft"
  "pending_approval"
  "approved"
  "exported"
  "partially_received"
  "received"
  "cancelled"
}

Table ref.agro_calendar_week [headercolor: #777777, note: 'ISO week -> season phase mapping for Lithuania; ML feature (EP03, finding F8).'] {
  "iso_week" "smallint" [pk, note: 'Surrogate primary key.']
  "season_phase_code" "character varying(20)" [not null, note: 'Reference to ref.season_phase.']
  "seasonal_weight" "numeric(4,2)" [not null, note: 'Expert seasonal intensity (1.00 = average week); peaks Feb-Mar and Jul-Sep.']

  Note: 'Integrity rules: ck_agro_calendar_week_range: CHECK (((iso_week >= 1) AND (iso_week <= 53))); ck_agro_calendar_week_weight: CHECK (((seasonal_weight > (0)::numeric) AND (seasonal_weight <= (5)::numeric)))'
}

Table ref.brand [headercolor: #777777, note: 'Machinery / OEM brands (Claas, John Deere, Fendt, Massey Ferguson, Lemken, Väderstad ...).'] {
  "id" "smallint" [pk, increment, note: 'Surrogate primary key.']
  "code" "character varying(10)" [not null, unique, note: 'Business code (natural key).']
  "name" "character varying(80)" [not null, unique, note: 'Display name.']
  "country_code" "character(2)" [not null, note: 'ISO 3166-1 alpha-2 country of the manufacturer.']

  Note: 'Integrity rules: ck_brand_country: CHECK ((country_code ~ \'^[A-Z]{2}$\'::text))'
}

Table ref.demand_class [headercolor: #777777, note: 'Syntetos-Boylan demand classification by ADI (cut-off 1.32) and CV² (cut-off 0.49); ranges are [lower, upper).'] {
  "code" "character varying(15)" [pk, note: 'Surrogate primary key.']
  "name" "character varying(40)" [not null, note: 'Display name.']
  "adi_lower" "numeric(6,3)" [not null]
  "adi_upper" "numeric(6,3)" [not null]
  "cv2_lower" "numeric(6,3)" [not null]
  "cv2_upper" "numeric(6,3)" [not null]
  "description" "text" [note: 'Description.']

  Note: 'Integrity rules: ck_demand_class_adi: CHECK (((adi_lower >= (0)::numeric) AND (adi_upper > adi_lower))); ck_demand_class_cv2: CHECK (((cv2_lower >= (0)::numeric) AND (cv2_upper > cv2_lower)))'
}

Table ref.machine_type [headercolor: #777777, note: 'Machine types: tractor, combine harvester, seeder, sprayer, forage harvester ...'] {
  "id" "smallint" [pk, increment, note: 'Surrogate primary key.']
  "code" "character varying(20)" [not null, unique, note: 'Business code (natural key).']
  "name" "character varying(80)" [not null, note: 'Display name.']
}

Table ref.movement_type [headercolor: #777777, note: 'Types of stock ledger movements and their effect on the on-hand balance.'] {
  "code" "character varying(20)" [pk, note: 'Surrogate primary key.']
  "name" "character varying(80)" [not null, note: 'Display name.']
  "balance_sign" "smallint" [not null, note: '+1 increases on-hand stock, -1 decreases it, 0 = no physical effect (imported historical demand).']
  "is_demand" "boolean" [not null, note: 'TRUE if the movement represents customer/service demand used for forecasting.']
  "description" "text" [note: 'Description.']

  Note: 'Integrity rules: ck_movement_type_code: CHECK (((code)::text ~ \'^[A-Z_]{3,20}$\'::text)); ck_movement_type_demand_is_issue: CHECK (((NOT is_demand) OR (balance_sign = ANY (ARRAY[\'-1\'::integer, 0])))); ck_movement_type_sign: CHECK ((balance_sign = ANY (ARRAY[\'-1\'::integer, 0, 1])))'
}

Table ref.operating_condition [headercolor: #777777, note: 'Operating conditions that shorten OEM service intervals (finding F5: e.g. non-prescribed oil halves the interval).'] {
  "id" "smallint" [pk, increment, note: 'Surrogate primary key.']
  "code" "character varying(20)" [not null, unique, note: 'Business code (natural key).']
  "name" "character varying(120)" [not null, note: 'Display name.']
  "interval_factor" "numeric(4,2)" [not null, note: 'Multiplier applied to the OEM interval: 1.00 = normal, 0.50 = halved.']

  Note: 'Integrity rules: ck_operating_condition_factor: CHECK (((interval_factor > (0)::numeric) AND (interval_factor <= (1)::numeric)))'
}

Table ref.part_category [headercolor: #777777, note: 'Hierarchical (self-referencing) spare part category tree, e.g. FILTERS > OIL_FILTERS.'] {
  "id" "integer" [pk, increment, note: 'Surrogate primary key.']
  "parent_id" "integer" [note: 'Parent category; NULL for a root category (recursive 1:N relationship).']
  "code" "character varying(30)" [not null, unique, note: 'Business code (natural key).']
  "name" "character varying(120)" [not null, note: 'Display name.']

  Note: 'Integrity rules: ck_part_category_not_self: CHECK ((parent_id IS DISTINCT FROM id))'
}

Table ref.season_phase [headercolor: #777777, note: 'Agrotechnical season phases (winter repair, sowing, crop care, harvest, autumn tillage).'] {
  "code" "character varying(20)" [pk, note: 'Surrogate primary key.']
  "name" "character varying(80)" [not null, note: 'Display name.']
}

Table ref.unit_of_measure [headercolor: #777777, note: 'Units of measure of spare parts (PCS, L, KG, M, SET).'] {
  "id" "smallint" [pk, increment, note: 'Surrogate primary key.']
  "code" "character varying(10)" [not null, unique, note: 'Business code (natural key).']
  "name" "character varying(50)" [not null, note: 'Display name.']
  "is_fractional" "boolean" [not null, default: `false`, note: 'TRUE if quantities may be fractional (litres of oil); FALSE for pieces.']

  Note: 'Integrity rules: ck_unit_of_measure_code: CHECK (((code)::text ~ \'^[A-Z0-9]{1,10}$\'::text))'
}

Table iam.app_user [headercolor: #8E24AA, note: 'Dealership employees using SmartSpare. Contains personal data (full_name, email, phone): masked for app_read / app_audit.'] {
  "id" "uuid" [pk, default: `gen_random_uuid()`, note: 'Surrogate primary key.']
  "user_name" "citext" [not null, unique]
  "email" "citext" [not null, unique, note: 'PERSONAL DATA (GDPR). Corporate e-mail; masked by util.mask_email for read-only roles.']
  "full_name" "character varying(150)" [not null, note: 'PERSONAL DATA (GDPR). Masked by util.mask_name for read-only roles.']
  "phone" "character varying(30)" [note: 'PERSONAL DATA (GDPR). Masked by util.mask_phone for read-only roles.']
  "password_hash" "text" [note: 'ASP.NET Core Identity V3 hash (PBKDF2-HMAC-SHA512, 100k iterations). Plain text is impossible by CHECK.']
  "security_stamp" "uuid" [not null, default: `gen_random_uuid()`, note: 'Changes on password/role change; invalidates issued JWT refresh tokens.']
  "is_active" "boolean" [not null, default: `true`, note: 'FALSE = deactivated, kept for history.']
  "failed_login_count" "smallint" [not null, default: `0`]
  "lockout_end" "timestamp with time zone"
  "home_warehouse_id" "smallint" [note: 'Reference to inventory.warehouse.']
  "last_login_at" "timestamp with time zone" [note: 'Time of the last login event.']
  "anonymised_at" "timestamp with time zone" [note: 'Set by iam.anonymise_user() (GDPR Art. 17); the row is kept so audit references stay valid.']
  "created_at" "timestamp with time zone" [not null, default: `now()`, note: 'Time the record was created.']
  "updated_at" "timestamp with time zone" [not null, default: `now()`, note: 'Time of the last change (maintained by trigger).']

  Note: 'Integrity rules: ck_app_user_active_has_password: CHECK (((password_hash IS NOT NULL) OR (NOT is_active))); ck_app_user_anonymised_inactive: CHECK (((anonymised_at IS NULL) OR (NOT is_active))); ck_app_user_email: CHECK ((email ~ \'^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$\'::citext)); ck_app_user_failed_logins: CHECK (((failed_login_count >= 0) AND (failed_login_count <= 100))); ck_app_user_password_hash_format: CHECK (((password_hash IS NULL) OR (password_hash ~ \'^AQAAAA[A-Za-z0-9+/]{76,}={0,2}$\'::text))); ck_app_user_phone: CHECK (((phone IS NULL) OR ((phone)::text ~ \'^\\+?[0-9 ()-]{7,20}$\'::text))); ck_app_user_user_name: CHECK ((user_name ~ \'^[a-z0-9._-]{3,50}$\'::citext))'
}

Table iam.role [headercolor: #8E24AA, note: 'Application (RBAC) roles from the BA: BRAND_MANAGER, SERVICE_ENGINEER, WAREHOUSE_KEEPER, INVENTORY_PLANNER, SPONSOR, ADMINISTRATOR.'] {
  "id" "smallint" [pk, increment, note: 'Surrogate primary key.']
  "code" "character varying(30)" [not null, unique, note: 'Business code (natural key).']
  "name" "character varying(80)" [not null, note: 'Display name.']
  "description" "text" [note: 'Description.']

  Note: 'Integrity rules: ck_role_code: CHECK (((code)::text ~ \'^[A-Z_]{3,30}$\'::text))'
}

Table iam.user_brand [headercolor: #8E24AA, note: 'M:N brand manager <-> brands they are responsible for (e.g. persona Tomas: Claas and Lemken).'] {
  "user_id" "uuid" [not null, note: 'Reference to iam.app_user.']
  "brand_id" "smallint" [not null, note: 'Reference to ref.brand.']

  indexes {
    (user_id, brand_id) [pk]
  }
}

Table iam.user_role [headercolor: #8E24AA, note: 'M:N user <-> role assignment.'] {
  "user_id" "uuid" [not null, note: 'Reference to iam.app_user.']
  "role_id" "smallint" [not null, note: 'Reference to iam.role.']
  "granted_at" "timestamp with time zone" [not null, default: `now()`, note: 'Time of the granted event.']
  "granted_by" "uuid" [note: 'User who performed the step (iam.app_user).']

  indexes {
    (user_id, role_id) [pk]
  }
}

Table catalog.part [headercolor: #1E88E5, note: 'Spare part (SKU) catalogue; natural key = brand + OEM part number.'] {
  "id" "bigint" [pk, increment, note: 'Surrogate primary key.']
  "brand_id" "smallint" [not null, note: 'Reference to ref.brand.']
  "oem_part_number" "character varying(40)" [not null, note: 'Manufacturer part number, upper-case, normalised during import.']
  "description" "character varying(300)" [not null, note: 'Description.']
  "category_id" "integer" [not null, note: 'Reference to ref.part_category.']
  "uom_id" "smallint" [not null, note: 'Reference to ref.unit_of_measure.']
  "weight_kg" "numeric(9,3)"
  "unit_cost" "numeric(12,2)" [not null, note: 'Standard (valuation) cost per unit, EUR. Money is numeric, never float.']
  "is_condition_based" "boolean" [not null, default: `false`, note: 'TRUE for parts replaced "as required" (air/cab filters, finding F6): demand only from the forecast stream.']
  "is_active" "boolean" [not null, default: `true`, note: 'FALSE = deactivated, kept for history.']
  "created_at" "timestamp with time zone" [not null, default: `now()`, note: 'Time the record was created.']
  "updated_at" "timestamp with time zone" [not null, default: `now()`, note: 'Time of the last change (maintained by trigger).']

  indexes {
    (brand_id, oem_part_number) [unique, name: 'uq_part_brand_oem']
  }

  Note: 'Integrity rules: ck_part_description: CHECK ((length(btrim((description)::text)) >= 3)); ck_part_oem_number: CHECK (((oem_part_number)::text ~ \'^[A-Z0-9][A-Z0-9.\\-/]{2,39}$\'::text)); ck_part_unit_cost: CHECK ((unit_cost >= (0)::numeric)); ck_part_weight: CHECK (((weight_kg IS NULL) OR (weight_kg >= (0)::numeric)))'
}

Table catalog.part_analogue [headercolor: #1E88E5, note: 'New SKU -> historical analogue/predecessor SKU with a demand scaling factor (US15).'] {
  "part_id" "bigint" [not null, note: 'Reference to catalog.part.']
  "analogue_part_id" "bigint" [not null, note: 'Reference to catalog.part.']
  "scaling_factor" "numeric(5,3)" [not null, default: `1.000`, note: 'Multiplier applied to the analogue\'s demand history (US15).']
  "valid_from" "date" [not null, default: `CURRENT_DATE`]
  "created_at" "timestamp with time zone" [not null, default: `now()`, note: 'Time the record was created.']

  indexes {
    (part_id, analogue_part_id) [pk]
  }

  Note: 'Integrity rules: ck_part_analogue_distinct: CHECK ((part_id <> analogue_part_id)); ck_part_analogue_factor: CHECK (((scaling_factor > (0)::numeric) AND (scaling_factor <= (10)::numeric)))'
}

Table catalog.supplier [headercolor: #1E88E5, note: 'OEM suppliers / distributors. Business contact data only (no personal data).'] {
  "id" "integer" [pk, increment, note: 'Surrogate primary key.']
  "code" "character varying(20)" [not null, unique, note: 'Business code (natural key).']
  "name" "character varying(200)" [not null, unique, note: 'Display name.']
  "country_code" "character(2)" [not null]
  "order_email" "citext" [note: 'Shared order mailbox of the company (e.g. orders@...), not a personal address.']
  "default_lead_time_days" "smallint" [not null]
  "currency_code" "character(3)" [not null, default: `'EUR'::bpchar`]
  "is_active" "boolean" [not null, default: `true`, note: 'FALSE = deactivated, kept for history.']
  "created_at" "timestamp with time zone" [not null, default: `now()`, note: 'Time the record was created.']
  "updated_at" "timestamp with time zone" [not null, default: `now()`, note: 'Time of the last change (maintained by trigger).']

  Note: 'Integrity rules: ck_supplier_country: CHECK ((country_code ~ \'^[A-Z]{2}$\'::text)); ck_supplier_currency: CHECK ((currency_code ~ \'^[A-Z]{3}$\'::text)); ck_supplier_email: CHECK (((order_email IS NULL) OR (order_email ~ \'^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$\'::citext))); ck_supplier_lead_time: CHECK (((default_lead_time_days >= 1) AND (default_lead_time_days <= 365)))'
}

Table catalog.supplier_part [headercolor: #1E88E5, note: 'Commercial conditions of a supplier for a part: MOQ, pack size, lead time (US12).'] {
  "id" "bigint" [pk, increment, note: 'Surrogate primary key.']
  "supplier_id" "integer" [not null, note: 'Reference to catalog.supplier.']
  "part_id" "bigint" [not null, note: 'Reference to catalog.part.']
  "supplier_part_number" "character varying(40)"
  "moq" "numeric(12,3)" [not null, default: `1`, note: 'Minimum order quantity; must be a multiple of pack_size.']
  "pack_size" "numeric(12,3)" [not null, default: `1`, note: 'Packaging increment; ordered quantities must be multiples of it.']
  "lead_time_days" "smallint" [not null, note: 'Supplier lead time for this part (calendar days).']
  "is_preferred" "boolean" [not null, default: `false`, note: 'Preferred supplier used for automatic PO drafts (max. one per part).']
  "created_at" "timestamp with time zone" [not null, default: `now()`, note: 'Time the record was created.']
  "updated_at" "timestamp with time zone" [not null, default: `now()`, note: 'Time of the last change (maintained by trigger).']

  indexes {
    (supplier_id, part_id) [unique, name: 'uq_supplier_part']
  }

  Note: 'Integrity rules: ck_supplier_part_lead_time: CHECK (((lead_time_days >= 1) AND (lead_time_days <= 365))); ck_supplier_part_moq: CHECK ((moq > (0)::numeric)); ck_supplier_part_moq_pack: CHECK ((mod(moq, pack_size) = (0)::numeric)); ck_supplier_part_pack: CHECK ((pack_size > (0)::numeric))'
}

Table catalog.supplier_price [headercolor: #1E88E5, note: 'Supplier purchase price history; non-overlapping validity periods per supplier-part (EXCLUDE USING gist).'] {
  "id" "bigint" [pk, increment, note: 'Surrogate primary key.']
  "supplier_part_id" "bigint" [not null, note: 'Reference to catalog.supplier_part.']
  "valid_during" "daterange" [not null, note: 'Validity period [from, to); open upper bound = valid until further notice.']
  "unit_price" "numeric(12,2)" [not null]

  Note: 'Integrity rules: ck_supplier_price_amount: CHECK ((unit_price > (0)::numeric)); ck_supplier_price_range: CHECK (((NOT isempty(valid_during)) AND (lower(valid_during) IS NOT NULL))); ex_supplier_price_no_overlap: EXCLUDE USING gist (supplier_part_id WITH =, valid_during WITH &&)'
}

Table inventory.demand_exception [headercolor: #00897B, note: '1:1 annotation of a demand movement as exceptional (US08). Kept separate because the ledger is immutable; excluded from ML training.'] {
  "movement_id" "bigint" [not null, note: 'Reference to inventory.stock_movement_202401.']
  "movement_occurred_at" "timestamp with time zone" [not null, note: 'Reference to inventory.stock_movement_202401.']
  "reason" "character varying(300)" [not null]
  "detection_method" "character varying(20)" [not null, default: `'manual'::character varying`]
  "flagged_by" "uuid" [note: 'User who performed the step (iam.app_user).']
  "flagged_at" "timestamp with time zone" [not null, default: `now()`, note: 'Time of the flagged event.']

  indexes {
    (movement_id, movement_occurred_at) [pk]
  }

  Note: 'Integrity rules: ck_demand_exception_method: CHECK (((detection_method)::text = ANY ((ARRAY[\'manual\'::character varying, \'auto_3sigma\'::character varying])::text[]))); ck_demand_exception_reason: CHECK ((length(btrim((reason)::text)) >= 5))'
}

Table inventory.stock_balance [headercolor: #00897B, note: 'Current stock per warehouse and part. Controlled redundancy: = SUM of the ledger, kept in sync by triggers for O(1) reads (NFR01).'] {
  "warehouse_id" "smallint" [not null, note: 'Reference to inventory.warehouse_part.']
  "part_id" "bigint" [not null, note: 'Reference to inventory.warehouse_part.']
  "on_hand_qty" "numeric(12,3)" [not null, default: `0`, note: 'Physical quantity in the warehouse (SUM of ledger movements); never negative.']
  "reserved_qty" "numeric(12,3)" [not null, default: `0`, note: 'Quantity held by active (soft/firm) reservations; never above on_hand_qty.']
  "available_qty" "numeric(12,3)" [default: `(on_hand_qty - reserved_qty)`, note: 'Generated column: on_hand - reserved (never stored inconsistently).']
  "last_movement_at" "timestamp with time zone" [note: 'Time of the latest physical movement (US04 "last updated").']
  "updated_at" "timestamp with time zone" [not null, default: `now()`, note: 'Time of the last change (maintained by trigger).']

  indexes {
    (warehouse_id, part_id) [pk]
  }

  Note: 'Integrity rules: ck_stock_balance_on_hand_non_negative: CHECK ((on_hand_qty >= (0)::numeric)); ck_stock_balance_reserved_le_on_hand: CHECK ((reserved_qty <= on_hand_qty)); ck_stock_balance_reserved_non_negative: CHECK ((reserved_qty >= (0)::numeric))'
}

Table inventory.stock_movement [headercolor: #00897B, note: 'Append-only stock ledger (single source of truth for stock and demand history). Partitioned by month; corrections only via compensating movements.'] {
  "id" "bigint" [increment, not null]
  "occurred_at" "timestamp with time zone" [not null, note: 'Business time of the movement; partition key (monthly ranges).']
  "warehouse_id" "smallint" [not null, note: 'Reference to inventory.warehouse.']
  "part_id" "bigint" [not null, note: 'Reference to catalog.part.']
  "movement_type_code" "character varying(20)" [not null, note: 'Type of movement; defines the sign (+/-/0) and whether it is demand.']
  "quantity" "numeric(12,3)" [not null, note: 'Always positive; direction comes from ref.movement_type.balance_sign.']
  "unit_cost" "numeric(12,2)" [note: 'Valuation cost per unit at the time of the movement (EUR).']
  "service_order_line_id" "bigint" [note: 'Reference to fleet.service_order_line.']
  "transfer_order_line_id" "bigint" [note: 'Reference to inventory.transfer_order_line.']
  "purchase_order_line_id" "bigint" [note: 'Reference to procurement.purchase_order_line.']
  "import_batch_id" "bigint" [note: 'Reference to raw.import_batch.']
  "external_doc_ref" "character varying(40)" [note: 'Document number in an external system (POS receipt, ERP document).']
  "note" "character varying(300)"
  "created_by" "uuid" [note: 'User who created the record (iam.app_user).']
  "created_at" "timestamp with time zone" [not null, default: `now()`, note: 'Time the record was created.']

  indexes {
    (id, occurred_at) [pk]
  }

  Note: 'Integrity rules: ck_stock_movement_quantity: CHECK ((quantity > (0)::numeric)); ck_stock_movement_single_document: CHECK ((num_nonnulls(service_order_line_id, transfer_order_line_id, purchase_order_line_id, import_batch_id) <= 1)); ck_stock_movement_source_document: CHECK ( CASE movement_type_code     WHEN \'RECEIPT_PO\'::text THEN (purchase_order_line_id IS NOT NULL)     WHEN \'TRANSFER_OUT\'::text THEN (transfer_order_line_id IS NOT NULL)     WHEN \'TRANSFER_IN\'::text THEN (transfer_order_line_id IS NOT NULL)     WHEN \'ISSUE_SERVICE\'::text THEN (service_order_line_id IS NOT NULL)     WHEN \'ISSUE_SALE\'::text THEN (external_doc_ref IS NOT NULL)     WHEN \'HISTORICAL_DEMAND\'::text THEN (import_batch_id IS NOT NULL)     WHEN \'ADJUSTMENT_IN\'::text THEN (note IS NOT NULL)     WHEN \'ADJUSTMENT_OUT\'::text THEN (note IS NOT NULL)     ELSE true END); ck_stock_movement_unit_cost: CHECK (((unit_cost IS NULL) OR (unit_cost >= (0)::numeric)))'
}

Table inventory.stock_reservation [headercolor: #00897B, note: 'Stock holds. Active (soft/firm) quantities are summed into stock_balance.reserved_qty by trigger.'] {
  "id" "bigint" [pk, increment, note: 'Surrogate primary key.']
  "warehouse_id" "smallint" [not null, note: 'Reference to inventory.stock_balance.']
  "part_id" "bigint" [not null, note: 'Reference to inventory.stock_balance.']
  "quantity" "numeric(12,3)" [not null, note: 'Quantity in the unit of measure of the part.']
  "status" inventory.reservation_status [not null, default: `'soft'::inventory.reservation_status`, note: 'Workflow status (state machine guarded by trigger).']
  "expires_at" "timestamp with time zone" [note: 'End of a soft hold (now + 7 days for service kits, UC02).']
  "service_order_line_id" "bigint" [note: 'Reference to fleet.service_order_line.']
  "transfer_order_line_id" "bigint" [note: 'Reference to inventory.transfer_order_line.']
  "created_by" "uuid" [note: 'User who created the record (iam.app_user).']
  "created_at" "timestamp with time zone" [not null, default: `now()`, note: 'Time the record was created.']
  "closed_at" "timestamp with time zone" [note: 'Time of the closed event.']

  Note: 'Integrity rules: ck_stock_reservation_closed: CHECK (((status = ANY (ARRAY[\'soft\'::inventory.reservation_status, \'firm\'::inventory.reservation_status])) = (closed_at IS NULL))); ck_stock_reservation_one_source: CHECK ((num_nonnulls(service_order_line_id, transfer_order_line_id) = 1)); ck_stock_reservation_quantity: CHECK ((quantity > (0)::numeric)); ck_stock_reservation_soft_expires: CHECK (((status <> \'soft\'::inventory.reservation_status) OR (expires_at IS NOT NULL)))'
}

Table inventory.transfer_order [headercolor: #00897B, note: 'Inter-warehouse transfer order (TR-YYYY-NNNNNN). Status changes only through inventory.approve/dispatch/receive/cancel_transfer().'] {
  "id" "bigint" [pk, increment, note: 'Surrogate primary key.']
  "number" "character varying(20)" [not null, unique, note: 'Business document number (assigned by trigger).']
  "from_warehouse_id" "smallint" [not null, note: 'Reference to inventory.warehouse_route.']
  "to_warehouse_id" "smallint" [not null, note: 'Reference to inventory.warehouse_route.']
  "status" inventory.transfer_status [not null, default: `'proposed'::inventory.transfer_status`, note: 'Workflow status (state machine guarded by trigger).']
  "is_urgent" "boolean" [not null, default: `false`, note: 'Flag: urgent.']
  "requested_by" "uuid" [note: 'User who created the record (iam.app_user).']
  "approved_by" "uuid" [note: 'User who performed the step (iam.app_user).']
  "approved_at" "timestamp with time zone" [note: 'Time of the approved event.']
  "dispatched_by" "uuid" [note: 'User who performed the step (iam.app_user).']
  "dispatched_at" "timestamp with time zone" [note: 'Time of the dispatched event.']
  "received_by" "uuid" [note: 'User who performed the step (iam.app_user).']
  "received_at" "timestamp with time zone" [note: 'Time of the received event.']
  "cancel_reason" "character varying(300)"
  "created_at" "timestamp with time zone" [not null, default: `now()`, note: 'Time the record was created.']
  "updated_at" "timestamp with time zone" [not null, default: `now()`, note: 'Time of the last change (maintained by trigger).']

  Note: 'Integrity rules: ck_transfer_order_approved: CHECK (((status = ANY (ARRAY[\'proposed\'::inventory.transfer_status, \'cancelled\'::inventory.transfer_status])) OR (approved_at IS NOT NULL))); ck_transfer_order_cancel: CHECK (((status = \'cancelled\'::inventory.transfer_status) = (cancel_reason IS NOT NULL))); ck_transfer_order_dispatched: CHECK (((status <> ALL (ARRAY[\'dispatched\'::inventory.transfer_status, \'received\'::inventory.transfer_status])) OR (dispatched_at IS NOT NULL))); ck_transfer_order_distinct: CHECK ((from_warehouse_id <> to_warehouse_id)); ck_transfer_order_number: CHECK (((number)::text ~ \'^TR-\\d{4}-\\d{6}$\'::text)); ck_transfer_order_received: CHECK (((status = \'received\'::inventory.transfer_status) = (received_at IS NOT NULL))); ck_transfer_order_timeline: CHECK (((dispatched_at IS NULL) OR (dispatched_at >= approved_at))); ck_transfer_order_timeline2: CHECK (((received_at IS NULL) OR (received_at >= dispatched_at)))'
}

Table inventory.transfer_order_line [headercolor: #00897B, note: 'Parts and quantities of a transfer; proposed_qty keeps the system proposal for KPI-04 (acceptance rate).'] {
  "id" "bigint" [pk, increment, note: 'Surrogate primary key.']
  "transfer_order_id" "bigint" [not null, note: 'Reference to inventory.transfer_order.']
  "part_id" "bigint" [not null, note: 'Reference to catalog.part.']
  "quantity" "numeric(12,3)" [not null, note: 'Quantity in the unit of measure of the part.']
  "proposed_qty" "numeric(12,3)" [note: 'Quantity proposed by the system; differs from quantity only with override_reason (KPI-04).']
  "override_reason" "character varying(300)" [note: 'Mandatory justification of a manual change (UC01 A2).']

  indexes {
    (transfer_order_id, part_id) [unique, name: 'uq_transfer_order_line_part']
  }

  Note: 'Integrity rules: ck_transfer_order_line_override: CHECK (((proposed_qty IS NULL) OR (quantity = proposed_qty) OR (override_reason IS NOT NULL))); ck_transfer_order_line_proposed: CHECK (((proposed_qty IS NULL) OR (proposed_qty > (0)::numeric))); ck_transfer_order_line_qty: CHECK ((quantity > (0)::numeric))'
}

Table inventory.warehouse [headercolor: #00897B, note: 'Regional branch warehouses (Vilnius central hub, Kaunas, Klaipėda, Šiauliai, Panevėžys, Marijampolė, Utena).'] {
  "id" "smallint" [pk, increment, note: 'Surrogate primary key.']
  "code" "character varying(10)" [not null, unique, note: 'Business code (natural key).']
  "name" "character varying(120)" [not null, note: 'Display name.']
  "city" "character varying(80)" [not null]
  "address" "character varying(200)"
  "is_central_hub" "boolean" [not null, default: `false`, note: 'Flag: central hub.']
  "latitude" "numeric(8,5)"
  "longitude" "numeric(8,5)"
  "is_active" "boolean" [not null, default: `true`, note: 'FALSE = deactivated, kept for history.']
  "created_at" "timestamp with time zone" [not null, default: `now()`, note: 'Time the record was created.']

  Note: 'Integrity rules: ck_warehouse_code: CHECK (((code)::text ~ \'^[A-Z]{3,10}$\'::text)); ck_warehouse_lat: CHECK (((latitude >= (\'-90\'::integer)::numeric) AND (latitude <= (90)::numeric))); ck_warehouse_lon: CHECK (((longitude >= (\'-180\'::integer)::numeric) AND (longitude <= (180)::numeric)))'
}

Table inventory.warehouse_part [headercolor: #00897B, note: 'Stocking policy of a part in a warehouse: shelf location, safety stock, maximum.'] {
  "warehouse_id" "smallint" [not null, note: 'Reference to inventory.warehouse.']
  "part_id" "bigint" [not null, note: 'Reference to catalog.part.']
  "bin_location" "character varying(20)"
  "safety_stock_qty" "numeric(12,3)" [not null, default: `0`, note: 'Local safety buffer; a donor hub may only give away stock above it (US10).']
  "max_stock_qty" "numeric(12,3)"
  "is_stocked" "boolean" [not null, default: `true`, note: 'Flag: stocked.']
  "updated_at" "timestamp with time zone" [not null, default: `now()`, note: 'Time of the last change (maintained by trigger).']

  indexes {
    (warehouse_id, part_id) [pk]
  }

  Note: 'Integrity rules: ck_warehouse_part_bin: CHECK (((bin_location IS NULL) OR ((bin_location)::text ~ \'^[A-Z0-9-]{2,20}$\'::text))); ck_warehouse_part_max: CHECK (((max_stock_qty IS NULL) OR (max_stock_qty >= safety_stock_qty))); ck_warehouse_part_safety: CHECK ((safety_stock_qty >= (0)::numeric))'
}

Table inventory.warehouse_route [headercolor: #00897B, note: 'Fixed inter-depot transport matrix (M:N warehouse-warehouse): distance, transit time, cost. Used by the rebalancing engine (US10).'] {
  "from_warehouse_id" "smallint" [not null, note: 'Reference to inventory.warehouse.']
  "to_warehouse_id" "smallint" [not null, note: 'Reference to inventory.warehouse.']
  "distance_km" "numeric(6,1)" [not null]
  "transit_hours" "numeric(5,1)" [not null, note: 'Planned inter-depot transport time incl. consolidation.']
  "transport_cost_eur" "numeric(10,2)" [not null, note: 'Cost of one inter-depot shipment (EUR).']

  indexes {
    (from_warehouse_id, to_warehouse_id) [pk]
  }

  Note: 'Integrity rules: ck_warehouse_route_cost: CHECK ((transport_cost_eur >= (0)::numeric)); ck_warehouse_route_distance: CHECK ((distance_km > (0)::numeric)); ck_warehouse_route_distinct: CHECK ((from_warehouse_id <> to_warehouse_id)); ck_warehouse_route_transit: CHECK (((transit_hours > (0)::numeric) AND (transit_hours <= (240)::numeric)))'
}

Table fleet.customer [headercolor: #FB8C00, note: 'Machine owner (farm). Pseudonymised: only a code and an HMAC of the ERP id are stored, no names or contacts.'] {
  "id" "bigint" [pk, increment, note: 'Surrogate primary key.']
  "customer_code" "character varying(12)" [not null, unique]
  "erp_ref_hash" "bytea" [unique, note: 'HMAC-SHA256 of the ERP customer id (util.pseudonymise); allows matching re-imports without storing the id.']
  "region_warehouse_id" "smallint" [not null, note: 'Reference to inventory.warehouse.']
  "farm_size_ha" "numeric(8,1)"
  "is_active" "boolean" [not null, default: `true`, note: 'FALSE = deactivated, kept for history.']
  "created_at" "timestamp with time zone" [not null, default: `now()`, note: 'Time the record was created.']

  Note: 'Integrity rules: ck_customer_code: CHECK (((customer_code)::text ~ \'^CUST-\\d{6}$\'::text)); ck_customer_erp_ref_hash: CHECK (((erp_ref_hash IS NULL) OR (length(erp_ref_hash) = 32))); ck_customer_farm_size: CHECK (((farm_size_ha IS NULL) OR (farm_size_ha > (0)::numeric)))'
}

Table fleet.engine_hours_reading [headercolor: #FB8C00, note: 'Odometer history (US05). Monotonic and physically plausible readings are enforced by trigger.'] {
  "id" "bigint" [pk, increment, note: 'Surrogate primary key.']
  "machine_id" "bigint" [not null, note: 'Reference to fleet.machine.']
  "reading_hours" "numeric(8,1)" [not null, note: 'Odometer value; must not decrease and must be physically plausible.']
  "read_at" "timestamp with time zone" [not null, note: 'Time the reading was taken in the field (may be earlier than created_at for offline entry).']
  "source" fleet.reading_source [not null, default: `'manual'::fleet.reading_source`]
  "recorded_by" "uuid" [note: 'User who performed the step (iam.app_user).']
  "created_at" "timestamp with time zone" [not null, default: `now()`, note: 'Time the record was created.']

  indexes {
    (machine_id, read_at) [unique, name: 'uq_engine_hours_reading_machine_time']
  }

  Note: 'Integrity rules: ck_engine_hours_reading_hours: CHECK (((reading_hours >= (0)::numeric) AND (reading_hours <= (100000)::numeric))); ck_engine_hours_reading_not_future: CHECK ((read_at <= (created_at + \'00:05:00\'::interval)))'
}

Table fleet.machine [headercolor: #FB8C00, note: 'Registered machine (installed base). current_engine_hours is maintained by the engine-hour reading trigger.'] {
  "id" "bigint" [pk, increment, note: 'Surrogate primary key.']
  "vin" "character varying(20)" [not null, unique, note: 'Vehicle / product identification number (unique).']
  "model_id" "integer" [not null, note: 'Reference to fleet.machine_model.']
  "customer_id" "bigint" [not null, note: 'Reference to fleet.customer.']
  "operating_condition_id" "smallint" [not null, note: 'Operating condition that shortens OEM intervals (F5).']
  "home_warehouse_id" "smallint" [not null, note: 'Nearest depot where service kits are reserved.']
  "manufacture_year" "smallint" [not null]
  "current_engine_hours" "numeric(8,1)" [not null, default: `0`, note: 'Latest odometer value; maintained by the reading trigger.']
  "engine_hours_read_at" "timestamp with time zone" [note: 'Time of the engine hours read event.']
  "status" fleet.machine_status [not null, default: `'active'::fleet.machine_status`, note: 'Workflow status (state machine guarded by trigger).']
  "commissioned_on" "date"
  "created_at" "timestamp with time zone" [not null, default: `now()`, note: 'Time the record was created.']
  "updated_at" "timestamp with time zone" [not null, default: `now()`, note: 'Time of the last change (maintained by trigger).']

  Note: 'Integrity rules: ck_machine_commissioned: CHECK (((commissioned_on IS NULL) OR (EXTRACT(year FROM commissioned_on) >= (manufacture_year)::numeric))); ck_machine_engine_hours: CHECK (((current_engine_hours >= (0)::numeric) AND (current_engine_hours <= (100000)::numeric))); ck_machine_vin: CHECK (((vin)::text ~ \'^[A-Z0-9]{8,20}$\'::text)); ck_machine_year: CHECK (((manufacture_year >= 1950) AND (manufacture_year <= 2100)))'
}

Table fleet.machine_model [headercolor: #FB8C00, note: 'Machine model, e.g. Claas Lexion 8700, John Deere 6R 150.'] {
  "id" "integer" [pk, increment, note: 'Surrogate primary key.']
  "brand_id" "smallint" [not null, note: 'Reference to ref.brand.']
  "machine_type_id" "smallint" [not null, note: 'Reference to ref.machine_type.']
  "model_name" "character varying(80)" [not null]

  indexes {
    (brand_id, model_name) [unique, name: 'uq_machine_model_brand_name']
  }
}

Table fleet.maintenance_plan [headercolor: #FB8C00, note: 'OEM service interval of a model (e.g. 500 h engine oil service). The effective interval = interval_hours x operating_condition.interval_factor.'] {
  "id" "integer" [pk, increment, note: 'Surrogate primary key.']
  "model_id" "integer" [not null, note: 'Reference to fleet.machine_model.']
  "interval_hours" "integer" [not null, note: 'OEM interval in engine hours (e.g. 500).']
  "name" "character varying(120)" [not null, note: 'Display name.']
  "is_active" "boolean" [not null, default: `true`, note: 'FALSE = deactivated, kept for history.']

  indexes {
    (model_id, interval_hours) [unique, name: 'uq_maintenance_plan_model_interval']
  }

  Note: 'Integrity rules: ck_maintenance_plan_interval: CHECK (((interval_hours >= 10) AND (interval_hours <= 20000)))'
}

Table fleet.maintenance_plan_part [headercolor: #FB8C00, note: 'Service kit / bill of materials of a maintenance plan (M:N plan <-> part with quantity).'] {
  "maintenance_plan_id" "integer" [not null, note: 'Reference to fleet.maintenance_plan.']
  "part_id" "bigint" [not null, note: 'Reference to catalog.part.']
  "quantity" "numeric(12,3)" [not null, note: 'Quantity of the part in the service kit.']

  indexes {
    (maintenance_plan_id, part_id) [pk]
  }

  Note: 'Integrity rules: ck_maintenance_plan_part_qty: CHECK ((quantity > (0)::numeric))'
}

Table fleet.service_order [headercolor: #FB8C00, note: 'Service order (SO-YYYY-NNNNNN). Planned (plan + due hours) or unplanned repair (plan NULL). Completed orders form the maintenance history.'] {
  "id" "bigint" [pk, increment, note: 'Surrogate primary key.']
  "number" "character varying(20)" [not null, unique, note: 'Business document number (assigned by trigger).']
  "machine_id" "bigint" [not null, note: 'Reference to fleet.machine.']
  "maintenance_plan_id" "integer" [note: 'Reference to fleet.maintenance_plan.']
  "warehouse_id" "smallint" [not null, note: 'Reference to inventory.warehouse.']
  "status" fleet.service_order_status [not null, default: `'draft'::fleet.service_order_status`, note: 'Workflow status (state machine guarded by trigger).']
  "due_engine_hours" "numeric(8,1)" [note: 'Engine-hour threshold this planned service covers (e.g. 500, 1000, 1500 ...).']
  "trigger_engine_hours" "numeric(8,1)" [note: 'Engine hours of the reading that triggered the draft.']
  "completed_engine_hours" "numeric(8,1)"
  "created_by" "uuid" [note: 'User who created the record (iam.app_user).']
  "created_at" "timestamp with time zone" [not null, default: `now()`, note: 'Time the record was created.']
  "completed_at" "timestamp with time zone" [note: 'Time of the completed event.']
  "cancel_reason" "character varying(300)"
  "updated_at" "timestamp with time zone" [not null, default: `now()`, note: 'Time of the last change (maintained by trigger).']

  Note: 'Integrity rules: ck_service_order_cancel: CHECK (((status = \'cancelled\'::fleet.service_order_status) = (cancel_reason IS NOT NULL))); ck_service_order_completed: CHECK (((status = \'completed\'::fleet.service_order_status) = ((completed_at IS NOT NULL) AND (completed_engine_hours IS NOT NULL)))); ck_service_order_number: CHECK (((number)::text ~ \'^SO-\\d{4}-\\d{6}$\'::text)); ck_service_order_planned_due: CHECK (((maintenance_plan_id IS NULL) OR (due_engine_hours IS NOT NULL)))'
}

Table fleet.service_order_line [headercolor: #FB8C00, note: 'Parts required by a service order (copied from the kit, editable for repairs).'] {
  "id" "bigint" [pk, increment, note: 'Surrogate primary key.']
  "service_order_id" "bigint" [not null, note: 'Reference to fleet.service_order.']
  "part_id" "bigint" [not null, note: 'Reference to catalog.part.']
  "qty_required" "numeric(12,3)" [not null, note: 'Quantity in the unit of measure of the part.']
  "qty_issued" "numeric(12,3)" [not null, default: `0`, note: 'Quantity already issued from stock (ISSUE_SERVICE).']

  indexes {
    (service_order_id, part_id) [unique, name: 'uq_service_order_line_part']
  }

  Note: 'Integrity rules: ck_service_order_line_issued: CHECK (((qty_issued >= (0)::numeric) AND (qty_issued <= qty_required))); ck_service_order_line_required: CHECK ((qty_required > (0)::numeric))'
}

Table procurement.purchase_order [headercolor: #D81B60, note: 'Supplier purchase order (PO-YYYY-NNNNNN). Drafts are generated from recommendations and approved by management (US14).'] {
  "id" "bigint" [pk, increment, note: 'Surrogate primary key.']
  "number" "character varying(20)" [not null, unique, note: 'Business document number (assigned by trigger).']
  "supplier_id" "integer" [not null, note: 'Reference to catalog.supplier.']
  "warehouse_id" "smallint" [not null, note: 'Reference to inventory.warehouse.']
  "status" procurement.po_status [not null, default: `'draft'::procurement.po_status`, note: 'Workflow status (state machine guarded by trigger).']
  "is_urgent" "boolean" [not null, default: `false`, note: 'US16 emergency direct purchase ("Urgent Harvest Dispatch"), bypasses weekly batching.']
  "urgent_reason" "character varying(300)"
  "currency_code" "character(3)" [not null, default: `'EUR'::bpchar`]
  "total_amount" "numeric(14,2)" [not null, default: `0`, note: 'Controlled redundancy: SUM(line_amount), maintained by trigger; needed by the four-eyes CHECK.']
  "expected_arrival_date" "date" [note: 'Approval date + longest supplier lead time of the lines.']
  "created_by" "uuid" [not null, note: 'User who created the record (iam.app_user).']
  "created_at" "timestamp with time zone" [not null, default: `now()`, note: 'Time the record was created.']
  "submitted_at" "timestamp with time zone" [note: 'Time of the submitted event.']
  "approved_by" "uuid" [note: 'User who performed the step (iam.app_user).']
  "approved_at" "timestamp with time zone" [note: 'Time of the approved event.']
  "exported_at" "timestamp with time zone" [note: 'Time of the exported event.']
  "cancel_reason" "character varying(300)"
  "updated_at" "timestamp with time zone" [not null, default: `now()`, note: 'Time of the last change (maintained by trigger).']

  Note: 'Integrity rules: ck_purchase_order_approved: CHECK (((status = ANY (ARRAY[\'draft\'::procurement.po_status, \'pending_approval\'::procurement.po_status, \'cancelled\'::procurement.po_status])) OR ((approved_by IS NOT NULL) AND (approved_at IS NOT NULL)))); ck_purchase_order_cancel: CHECK (((status = \'cancelled\'::procurement.po_status) = (cancel_reason IS NOT NULL))); ck_purchase_order_currency: CHECK ((currency_code ~ \'^[A-Z]{3}$\'::text)); ck_purchase_order_four_eyes: CHECK (((approved_by IS NULL) OR (total_amount <= (5000)::numeric) OR (approved_by <> created_by))); ck_purchase_order_number: CHECK (((number)::text ~ \'^PO-\\d{4}-\\d{6}$\'::text)); ck_purchase_order_timeline: CHECK (((approved_at IS NULL) OR (approved_at >= created_at))); ck_purchase_order_total: CHECK ((total_amount >= (0)::numeric)); ck_purchase_order_urgent: CHECK (((NOT is_urgent) OR (urgent_reason IS NOT NULL)))'
}

Table procurement.purchase_order_line [headercolor: #D81B60, note: 'PO line. MOQ / pack-size rules of catalog.supplier_part are enforced by trigger.'] {
  "id" "bigint" [pk, increment, note: 'Surrogate primary key.']
  "purchase_order_id" "bigint" [not null, note: 'Reference to procurement.purchase_order.']
  "part_id" "bigint" [not null, note: 'Reference to catalog.part.']
  "quantity" "numeric(12,3)" [not null, note: 'Quantity in the unit of measure of the part.']
  "unit_price" "numeric(12,2)" [not null]
  "line_amount" "numeric(14,2)" [default: `round((quantity * unit_price), 2)`, note: 'Generated column: round(quantity x unit_price, 2).']
  "received_qty" "numeric(12,3)" [not null, default: `0`, note: 'Quantity received so far (partial receipts).']
  "proposed_qty" "numeric(12,3)"
  "override_reason" "character varying(300)"

  indexes {
    (purchase_order_id, part_id) [unique, name: 'uq_purchase_order_line_part']
  }

  Note: 'Integrity rules: ck_purchase_order_line_override: CHECK (((proposed_qty IS NULL) OR (quantity = proposed_qty) OR (override_reason IS NOT NULL))); ck_purchase_order_line_price: CHECK ((unit_price > (0)::numeric)); ck_purchase_order_line_qty: CHECK ((quantity > (0)::numeric)); ck_purchase_order_line_received: CHECK (((received_qty >= (0)::numeric) AND (received_qty <= quantity)))'
}

Table forecast.benchmark_result [headercolor: #3949AB, note: 'Holdout accuracy of a candidate model and of the 5 benchmarks per demand class (KPI-02: ML must have >= 10% lower RMSSE).'] {
  "model_version_id" "integer" [not null, note: 'Reference to forecast.ml_model_version.']
  "method" forecast.forecast_method [not null]
  "demand_class_code" "character varying(15)" [not null, note: 'Reference to ref.demand_class.']
  "series_count" "integer" [not null]
  "rmsse" "numeric(8,4)" [not null]
  "mase" "numeric(8,4)" [not null]

  indexes {
    (model_version_id, method, demand_class_code) [pk]
  }

  Note: 'Integrity rules: ck_benchmark_result_metrics: CHECK (((rmsse >= (0)::numeric) AND (mase >= (0)::numeric))); ck_benchmark_result_series: CHECK ((series_count > 0))'
}

Table forecast.demand_forecast [headercolor: #3949AB, note: 'Weekly forecast quantity per run, warehouse and part (ternary relationship run x warehouse x part, plus week).'] {
  "forecast_run_id" "bigint" [not null, note: 'Reference to forecast.forecast_run.']
  "warehouse_id" "smallint" [not null, note: 'Reference to inventory.warehouse_part.']
  "part_id" "bigint" [not null, note: 'Reference to inventory.warehouse_part.']
  "week_start" "date" [not null, note: 'Monday of the forecast ISO week.']
  "forecast_qty" "numeric(12,3)" [not null]

  indexes {
    (forecast_run_id, warehouse_id, part_id, week_start) [pk]
  }

  Note: 'Integrity rules: ck_demand_forecast_monday: CHECK ((EXTRACT(isodow FROM week_start) = (1)::numeric)); ck_demand_forecast_qty: CHECK ((forecast_qty >= (0)::numeric))'
}

Table forecast.forecast_run [headercolor: #3949AB, note: 'One execution of the forecasting pipeline (Quartz.NET weekly or user-triggered, horizon 4-12 weeks).'] {
  "id" "bigint" [pk, increment, note: 'Surrogate primary key.']
  "model_version_id" "integer" [not null, note: 'Reference to forecast.ml_model_version.']
  "status" forecast.run_status [not null, default: `'running'::forecast.run_status`, note: 'Workflow status (state machine guarded by trigger).']
  "horizon_weeks" "smallint" [not null]
  "first_week" "date" [not null]
  "triggered_by" "character varying(10)" [not null]
  "requested_by" "uuid" [note: 'User who created the record (iam.app_user).']
  "started_at" "timestamp with time zone" [not null, default: `now()`, note: 'Time of the started event.']
  "finished_at" "timestamp with time zone" [note: 'Time of the finished event.']
  "error_message" "text"

  Note: 'Integrity rules: ck_forecast_run_error: CHECK (((status = \'failed\'::forecast.run_status) = (error_message IS NOT NULL))); ck_forecast_run_finished: CHECK (((status = \'running\'::forecast.run_status) = (finished_at IS NULL))); ck_forecast_run_first_week_monday: CHECK ((EXTRACT(isodow FROM first_week) = (1)::numeric)); ck_forecast_run_horizon: CHECK (((horizon_weeks >= 4) AND (horizon_weeks <= 12))); ck_forecast_run_timeline: CHECK (((finished_at IS NULL) OR (finished_at >= started_at))); ck_forecast_run_trigger: CHECK (((triggered_by)::text = ANY ((ARRAY[\'scheduler\'::character varying, \'user\'::character varying])::text[]))); ck_forecast_run_user: CHECK ((((triggered_by)::text = \'scheduler\'::text) OR (requested_by IS NOT NULL)))'
}

Table forecast.ml_model_version [headercolor: #3949AB, note: 'Versioned ML / benchmark models. A candidate is promoted to active only if it beats the best benchmark (forecast.promote_model).'] {
  "id" "integer" [pk, increment, note: 'Surrogate primary key.']
  "algorithm" forecast.forecast_method [not null]
  "version_label" "character varying(30)" [not null]
  "demand_class_code" "character varying(15)" [note: 'Reference to ref.demand_class.']
  "status" forecast.model_status [not null, default: `'training'::forecast.model_status`, note: 'Workflow status (state machine guarded by trigger).']
  "training_from" "date" [not null]
  "training_to" "date" [not null]
  "holdout_from" "date" [not null]
  "holdout_to" "date" [not null]
  "rmsse" "numeric(8,4)" [note: 'Root mean squared scaled error on the holdout period (KPI-02 metric).']
  "mase" "numeric(8,4)" [note: 'Mean absolute scaled error on the holdout period.']
  "mae" "numeric(12,4)"
  "rmse" "numeric(12,4)"
  "hyperparameters" "jsonb" [not null, default: `'{}'::jsonb`, note: 'Algorithm-specific settings as a JSON object, e.g. {"numberOfTrees":200,"numberOfLeaves":31,"learningRate":0.1}.']
  "artifact_uri" "character varying(500)" [note: 'Location of the serialised ML.NET model (.zip) in Azure Blob Storage.']
  "artifact_sha256" "character(64)"
  "trained_at" "timestamp with time zone" [note: 'Time of the trained event.']
  "promoted_at" "timestamp with time zone" [note: 'Time of the promoted event.']
  "retired_at" "timestamp with time zone" [note: 'Time of the retired event.']
  "created_at" "timestamp with time zone" [not null, default: `now()`, note: 'Time the record was created.']

  indexes {
    (algorithm, version_label) [unique, name: 'uq_ml_model_version_label']
  }

  Note: 'Integrity rules: ck_ml_model_version_active: CHECK (((status <> \'active\'::forecast.model_status) OR (promoted_at IS NOT NULL))); ck_ml_model_version_artifact: CHECK (((algorithm <> \'fasttree\'::forecast.forecast_method) OR (status = \'training\'::forecast.model_status) OR (artifact_uri IS NOT NULL))); ck_ml_model_version_chronological_holdout: CHECK (((holdout_from > training_to) AND (holdout_to >= holdout_from))); ck_ml_model_version_evaluated: CHECK (((status = ANY (ARRAY[\'training\'::forecast.model_status, \'rejected\'::forecast.model_status])) OR ((rmsse IS NOT NULL) AND (trained_at IS NOT NULL)))); ck_ml_model_version_hyperparameters: CHECK ((jsonb_typeof(hyperparameters) = \'object\'::text)); ck_ml_model_version_label: CHECK (((version_label)::text ~ \'^v\\d+\\.\\d+(\\.\\d+)?$\'::text)); ck_ml_model_version_metrics: CHECK ((((rmsse IS NULL) OR (rmsse >= (0)::numeric)) AND ((mase IS NULL) OR (mase >= (0)::numeric)) AND ((mae IS NULL) OR (mae >= (0)::numeric)) AND ((rmse IS NULL) OR (rmse >= (0)::numeric)))); ck_ml_model_version_sha: CHECK (((artifact_sha256 IS NULL) OR (artifact_sha256 ~ \'^[0-9a-f]{64}$\'::text))); ck_ml_model_version_training: CHECK ((training_to > training_from))'
}

Table forecast.recommendation [headercolor: #3949AB, note: 'Explainable transfer / purchase proposal. Stores every driver of the calculation (NFR08) and the human decision (KPI-04).'] {
  "id" "bigint" [pk, increment, note: 'Surrogate primary key.']
  "forecast_run_id" "bigint" [not null, note: 'Reference to forecast.forecast_run.']
  "kind" forecast.recommendation_kind [not null]
  "warehouse_id" "smallint" [not null, note: 'Reference to inventory.warehouse_part.']
  "part_id" "bigint" [not null, note: 'Reference to inventory.warehouse_part.']
  "donor_warehouse_id" "smallint" [note: 'Reference to inventory.warehouse.']
  "supplier_id" "integer" [note: 'Reference to catalog.supplier.']
  "base_demand_qty" "numeric(12,3)" [not null, note: 'NFR08 (a): ML forecast over the horizon.']
  "maintenance_demand_qty" "numeric(12,3)" [not null, note: 'NFR08 (b): planned maintenance demand not yet reserved.']
  "lead_time_buffer_qty" "numeric(12,3)" [not null, note: 'NFR08 (c): demand expected during the replenishment lead time.']
  "safety_stock_qty" "numeric(12,3)" [not null, note: 'NFR08 (d): safety stock of the hub.']
  "available_qty" "numeric(12,3)" [not null]
  "in_transit_qty" "numeric(12,3)" [not null]
  "net_position_qty" "numeric(12,3)" [not null, note: 'Available + in transit - (a + b + c + d); negative = shortage.']
  "recommended_qty" "numeric(12,3)" [not null]
  "estimated_cost_eur" "numeric(12,2)" [not null]
  "alternative_cost_eur" "numeric(12,2)" [note: 'Cost of the alternative (e.g. emergency supplier order EUR 280 vs. transfer EUR 45, UC01 step 9).']
  "status" forecast.recommendation_status [not null, default: `'open'::forecast.recommendation_status`, note: 'Workflow status (state machine guarded by trigger).']
  "final_qty" "numeric(12,3)" [note: 'Quantity decided by the user (KPI-04: accepted when equal to recommended_qty).']
  "decided_by" "uuid" [note: 'User who performed the step (iam.app_user).']
  "decided_at" "timestamp with time zone" [note: 'Time of the decided event.']
  "decision_reason" "character varying(300)"
  "transfer_order_id" "bigint" [note: 'Reference to inventory.transfer_order.']
  "purchase_order_id" "bigint" [note: 'Reference to procurement.purchase_order.']
  "created_at" "timestamp with time zone" [not null, default: `now()`, note: 'Time the record was created.']

  Note: 'Integrity rules: ck_recommendation_accepted: CHECK (((status <> \'accepted\'::forecast.recommendation_status) OR (final_qty = recommended_qty))); ck_recommendation_cost: CHECK (((estimated_cost_eur >= (0)::numeric) AND ((alternative_cost_eur IS NULL) OR (alternative_cost_eur >= (0)::numeric)))); ck_recommendation_decided: CHECK (((status = ANY (ARRAY[\'open\'::forecast.recommendation_status, \'expired\'::forecast.recommendation_status])) = (decided_at IS NULL))); ck_recommendation_drivers: CHECK (((base_demand_qty >= (0)::numeric) AND (maintenance_demand_qty >= (0)::numeric) AND (lead_time_buffer_qty >= (0)::numeric) AND (safety_stock_qty >= (0)::numeric) AND (available_qty >= (0)::numeric) AND (in_transit_qty >= (0)::numeric))); ck_recommendation_final_qty: CHECK (((status <> ALL (ARRAY[\'accepted\'::forecast.recommendation_status, \'overridden\'::forecast.recommendation_status])) OR ((final_qty > (0)::numeric) AND (decided_by IS NOT NULL)))); ck_recommendation_kind_purchase: CHECK (((kind <> \'purchase\'::forecast.recommendation_kind) OR ((supplier_id IS NOT NULL) AND (donor_warehouse_id IS NULL)))); ck_recommendation_kind_transfer: CHECK (((kind <> \'transfer\'::forecast.recommendation_kind) OR ((donor_warehouse_id IS NOT NULL) AND (supplier_id IS NULL) AND (donor_warehouse_id <> warehouse_id)))); ck_recommendation_net_position: CHECK ((net_position_qty = ((available_qty + in_transit_qty) - (((base_demand_qty + maintenance_demand_qty) + lead_time_buffer_qty) + safety_stock_qty)))); ck_recommendation_override: CHECK (((status <> ALL (ARRAY[\'overridden\'::forecast.recommendation_status, \'rejected\'::forecast.recommendation_status])) OR (decision_reason IS NOT NULL))); ck_recommendation_override_qty: CHECK (((status <> \'overridden\'::forecast.recommendation_status) OR (final_qty <> recommended_qty))); ck_recommendation_qty: CHECK ((recommended_qty > (0)::numeric))'
}

Table audit.audit_log [headercolor: #546E7A, note: 'Immutable audit trail of state-changing operations: timestamp, user, action, previous and new values, reason (US18).'] {
  "id" "bigint" [increment, not null]
  "occurred_at" "timestamp with time zone" [not null, default: `clock_timestamp()`, note: 'Time of the occurred event.']
  "user_id" "uuid" [note: 'Application user (GUC app.user_id); NULL for background jobs.']
  "db_role" "name" [not null, default: `SESSION_USER`]
  "action" "character varying(10)" [not null]
  "table_name" "character varying(80)" [not null]
  "record_id" "character varying(80)" [not null]
  "old_values" "jsonb" [note: 'Previous values of the changed columns only (personal data columns are excluded).']
  "new_values" "jsonb"
  "changed_columns" "text[]"
  "reason" "character varying(300)" [note: 'Business justification (GUC app.reason), e.g. reason for a manual override.']
  "transaction_id" "bigint" [not null, default: `txid_current()`]

  indexes {
    (id, occurred_at) [pk]
  }

  Note: 'Integrity rules: ck_audit_log_action: CHECK (((action)::text = ANY ((ARRAY[\'INSERT\'::character varying, \'UPDATE\'::character varying, \'DELETE\'::character varying])::text[]))); ck_audit_log_new: CHECK (((new_values IS NULL) OR (jsonb_typeof(new_values) = \'object\'::text))); ck_audit_log_old: CHECK (((old_values IS NULL) OR (jsonb_typeof(old_values) = \'object\'::text))); ck_audit_log_shape: CHECK (((((action)::text = \'INSERT\'::text) AND (old_values IS NULL) AND (new_values IS NOT NULL)) OR (((action)::text = \'UPDATE\'::text) AND (old_values IS NOT NULL) AND (new_values IS NOT NULL)) OR (((action)::text = \'DELETE\'::text) AND (old_values IS NOT NULL) AND (new_values IS NULL))))'
}

