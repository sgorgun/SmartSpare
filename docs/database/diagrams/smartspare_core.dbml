Ref fk_stock_reservation_balance: inventory.stock_reservation.(warehouse_id, part_id) > inventory.stock_balance.(warehouse_id, part_id) [delete: restrict]
Ref fk_stock_reservation_created_by: inventory.stock_reservation.created_by > iam.app_user.id [delete: set null]
