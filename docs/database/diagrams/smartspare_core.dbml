// ---------------------------------------------------------------- modules
TableGroup ref [color: #777777, note: 'Reference data'] {
  ref.agro_calendar_week
  ref.brand
  ref.demand_class
  ref.machine_type
  ref.movement_type
  ref.operating_condition
  ref.part_category
  ref.season_phase
  ref.unit_of_measure
}
TableGroup iam [color: #8E24AA, note: 'Identity & Access'] {
  iam.app_user
  iam.role
  iam.user_brand
  iam.user_role
}
TableGroup catalog [color: #1E88E5, note: 'Inventory — catalogue'] {
  catalog.part
  catalog.part_analogue
  catalog.supplier
  catalog.supplier_part
  catalog.supplier_price
}
TableGroup inventory [color: #00897B, note: 'Inventory — stock & transfers'] {
  inventory.demand_exception
  inventory.stock_balance
  inventory.stock_movement
  inventory.stock_reservation
  inventory.transfer_order
  inventory.transfer_order_line
  inventory.warehouse
  inventory.warehouse_part
  inventory.warehouse_route
}
TableGroup fleet [color: #FB8C00, note: 'Fleet & Maintenance'] {
  fleet.customer
  fleet.engine_hours_reading
  fleet.machine
  fleet.machine_model
  fleet.maintenance_plan
  fleet.maintenance_plan_part
  fleet.service_order
  fleet.service_order_line
}
TableGroup procurement [color: #D81B60, note: 'Procurement'] {
  procurement.purchase_order
  procurement.purchase_order_line
}
TableGroup forecast [color: #3949AB, note: 'Forecasting (ML)'] {
  forecast.benchmark_result
  forecast.demand_forecast
  forecast.forecast_run
  forecast.ml_model_version
  forecast.recommendation
}
TableGroup audit [color: #546E7A, note: 'Audit'] {
  audit.audit_log
}
