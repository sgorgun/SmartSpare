digraph ER {
  graph [rankdir=LR, splines=true, nodesep=0.35, ranksep=1.1, fontname="Helvetica", label=<<B>SmartSpare — logical schema overview (keys only)</B>>, labelloc=t, fontsize=22, pad=0.4];
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [color="#555555", arrowsize=0.8, penwidth=1.0];
  subgraph cluster_ref { label=<<B>ref</B> — Platform — reference data>; style="rounded,filled"; fillcolor="#EEEEEE"; color="#777777"; fontsize=14; penwidth=2;
    "ref.agro_calendar_week" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#777777"><TR><TD BGCOLOR="#777777" COLSPAN="2"><FONT COLOR="white"><B>agro_calendar_week</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="iso_week">PK <B>iso_week</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="season_phase_code">FK season_phase_code*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 1 attributes</FONT></I></TD></TR></TABLE>>];
    "ref.brand" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#777777"><TR><TD BGCOLOR="#777777" COLSPAN="2"><FONT COLOR="white"><B>brand</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code">UQcode*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">UQname*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 1 attributes</FONT></I></TD></TR></TABLE>>];
    "ref.demand_class" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#777777"><TR><TD BGCOLOR="#777777" COLSPAN="2"><FONT COLOR="white"><B>demand_class</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code">PK <B>code</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(15)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 6 attributes</FONT></I></TD></TR></TABLE>>];
    "ref.machine_type" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#777777"><TR><TD BGCOLOR="#777777" COLSPAN="2"><FONT COLOR="white"><B>machine_type</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code">UQcode*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 1 attributes</FONT></I></TD></TR></TABLE>>];
    "ref.movement_type" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#777777"><TR><TD BGCOLOR="#777777" COLSPAN="2"><FONT COLOR="white"><B>movement_type</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code">PK <B>code</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 4 attributes</FONT></I></TD></TR></TABLE>>];
    "ref.operating_condition" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#777777"><TR><TD BGCOLOR="#777777" COLSPAN="2"><FONT COLOR="white"><B>operating_condition</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code">UQcode*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 2 attributes</FONT></I></TD></TR></TABLE>>];
    "ref.part_category" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#777777"><TR><TD BGCOLOR="#777777" COLSPAN="2"><FONT COLOR="white"><B>part_category</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="parent_id">FK parent_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code">UQcode*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 1 attributes</FONT></I></TD></TR></TABLE>>];
    "ref.season_phase" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#777777"><TR><TD BGCOLOR="#777777" COLSPAN="2"><FONT COLOR="white"><B>season_phase</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code">PK <B>code</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 1 attributes</FONT></I></TD></TR></TABLE>>];
    "ref.unit_of_measure" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#777777"><TR><TD BGCOLOR="#777777" COLSPAN="2"><FONT COLOR="white"><B>unit_of_measure</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code">UQcode*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 2 attributes</FONT></I></TD></TR></TABLE>>];
  }
  subgraph cluster_iam { label=<<B>iam</B> — Identity>; style="rounded,filled"; fillcolor="#F3E5F5"; color="#8E24AA"; fontsize=14; penwidth=2;
    "iam.app_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#8E24AA"><TR><TD BGCOLOR="#8E24AA" COLSPAN="2"><FONT COLOR="white"><B>app_user</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_name">UQuser_name*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">citext</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email">UQemail*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">citext</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 12 attributes</FONT></I></TD></TR></TABLE>>];
    "iam.data_protection_keys" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#8E24AA"><TR><TD BGCOLOR="#8E24AA" COLSPAN="2"><FONT COLOR="white"><B>data_protection_keys</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 2 attributes</FONT></I></TD></TR></TABLE>>];
    "iam.role" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#8E24AA"><TR><TD BGCOLOR="#8E24AA" COLSPAN="2"><FONT COLOR="white"><B>role</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code">UQcode*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 2 attributes</FONT></I></TD></TR></TABLE>>];
    "iam.user_brand" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#8E24AA"><TR><TD BGCOLOR="#8E24AA" COLSPAN="2"><FONT COLOR="white"><B>user_brand</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">PK FK <B>user_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="brand_id">PK FK <B>brand_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR></TABLE>>];
    "iam.user_role" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#8E24AA"><TR><TD BGCOLOR="#8E24AA" COLSPAN="2"><FONT COLOR="white"><B>user_role</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">PK FK <B>user_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="role_id">PK FK <B>role_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="granted_by">FK granted_by</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 1 attributes</FONT></I></TD></TR></TABLE>>];
  }
  subgraph cluster_catalog { label=<<B>catalog</B> — Inventory — catalogue>; style="rounded,filled"; fillcolor="#E3F2FD"; color="#1E88E5"; fontsize=14; penwidth=2;
    "catalog.part" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#1E88E5"><TR><TD BGCOLOR="#1E88E5" COLSPAN="2"><FONT COLOR="white"><B>part</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="brand_id">FK brand_id*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_id">FK category_id*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="uom_id">FK uom_id*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 8 attributes</FONT></I></TD></TR></TABLE>>];
    "catalog.part_analogue" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#1E88E5"><TR><TD BGCOLOR="#1E88E5" COLSPAN="2"><FONT COLOR="white"><B>part_analogue</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="part_id">PK FK <B>part_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="analogue_part_id">PK FK <B>analogue_part_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 3 attributes</FONT></I></TD></TR></TABLE>>];
  }
  subgraph cluster_inventory { label=<<B>inventory</B> — Inventory — stock &amp; transfers>; style="rounded,filled"; fillcolor="#E0F2F1"; color="#00897B"; fontsize=14; penwidth=2;
    "inventory.demand_exception" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#00897B"><TR><TD BGCOLOR="#00897B" COLSPAN="2"><FONT COLOR="white"><B>demand_exception</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="movement_id">PK FK <B>movement_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="movement_occurred_at">PK FK <B>movement_occurred_at</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 4 attributes</FONT></I></TD></TR></TABLE>>];
    "inventory.stock_balance" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#00897B"><TR><TD BGCOLOR="#00897B" COLSPAN="2"><FONT COLOR="white"><B>stock_balance</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="warehouse_id">PK FK <B>warehouse_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="part_id">PK FK <B>part_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 5 attributes</FONT></I></TD></TR></TABLE>>];
    "inventory.stock_movement" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#00897B"><TR><TD BGCOLOR="#00897B" COLSPAN="2"><FONT COLOR="white"><B>stock_movement</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="occurred_at">PK <B>occurred_at</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="warehouse_id">FK warehouse_id*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="part_id">FK part_id*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="movement_type_code">FK movement_type_code*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="transfer_order_line_id">FK transfer_order_line_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="import_batch_id">FK import_batch_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 8 attributes</FONT></I></TD></TR></TABLE>>];
    "inventory.stock_reservation" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#00897B"><TR><TD BGCOLOR="#00897B" COLSPAN="2"><FONT COLOR="white"><B>stock_reservation</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="warehouse_id">FK warehouse_id*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="part_id">FK part_id*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="transfer_order_line_id">FK transfer_order_line_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 7 attributes</FONT></I></TD></TR></TABLE>>];
    "inventory.transfer_order" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#00897B"><TR><TD BGCOLOR="#00897B" COLSPAN="2"><FONT COLOR="white"><B>transfer_order</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="number">UQnumber*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="from_warehouse_id">FK from_warehouse_id*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="to_warehouse_id">FK to_warehouse_id*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 12 attributes</FONT></I></TD></TR></TABLE>>];
