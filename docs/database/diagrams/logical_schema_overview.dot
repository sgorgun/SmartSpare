    "fleet.machine" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#FB8C00"><TR><TD BGCOLOR="#FB8C00" COLSPAN="2"><FONT COLOR="white"><B>machine</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="vin">UQvin*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="model_id">FK model_id*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id">FK customer_id*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="operating_condition_id">FK operating_condition_id*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 8 attributes</FONT></I></TD></TR></TABLE>>];
