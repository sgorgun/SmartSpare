  subgraph cluster_fleet { label=<<B>fleet</B> — Fleet>; style="rounded,filled"; fillcolor="#FFF3E0"; color="#FB8C00"; fontsize=14; penwidth=2;
    "fleet.customer" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#FB8C00"><TR><TD BGCOLOR="#FB8C00" COLSPAN="2"><FONT COLOR="white"><B>customer</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="customer_code">UQcustomer_code*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(12)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="erp_ref_hash">UQerp_ref_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bytea</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><I><FONT COLOR="#888888">+ 4 attributes</FONT></I></TD></TR></TABLE>>];
