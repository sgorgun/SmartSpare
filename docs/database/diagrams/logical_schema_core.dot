digraph ER {
  graph [rankdir=LR, splines=true, nodesep=0.35, ranksep=1.1, fontname="Helvetica", label=<<B>SmartSpare — logical schema of the OLTP core (3NF)</B>>, labelloc=t, fontsize=22, pad=0.4];
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [color="#555555", arrowsize=0.8, penwidth=1.0];
  subgraph cluster_ref { label=<<B>ref</B> — Platform — reference data>; style="rounded,filled"; fillcolor="#EEEEEE"; color="#777777"; fontsize=14; penwidth=2;
    "ref.agro_calendar_week" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#777777"><TR><TD BGCOLOR="#777777" COLSPAN="2"><FONT COLOR="white"><B>agro_calendar_week</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="iso_week">PK <B>iso_week</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="season_phase_code">FK season_phase_code*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="seasonal_weight">seasonal_weight*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">numeric(4,2)</FONT></TD></TR></TABLE>>];
    "ref.brand" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#777777"><TR><TD BGCOLOR="#777777" COLSPAN="2"><FONT COLOR="white"><B>brand</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code">UQcode*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">UQname*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="country_code">country_code*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">char(2)</FONT></TD></TR></TABLE>>];
    "ref.demand_class" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#777777"><TR><TD BGCOLOR="#777777" COLSPAN="2"><FONT COLOR="white"><B>demand_class</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code">PK <B>code</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(15)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="adi_lower">adi_lower*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">numeric(6,3)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="adi_upper">adi_upper*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">numeric(6,3)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cv2_lower">cv2_lower*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">numeric(6,3)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cv2_upper">cv2_upper*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">numeric(6,3)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="description">description</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">text</FONT></TD></TR></TABLE>>];
    "ref.machine_type" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#777777"><TR><TD BGCOLOR="#777777" COLSPAN="2"><FONT COLOR="white"><B>machine_type</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code">UQcode*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(80)</FONT></TD></TR></TABLE>>];
    "ref.movement_type" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#777777"><TR><TD BGCOLOR="#777777" COLSPAN="2"><FONT COLOR="white"><B>movement_type</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code">PK <B>code</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="balance_sign">balance_sign*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_demand">is_demand*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="description">description</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">text</FONT></TD></TR></TABLE>>];
    "ref.operating_condition" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#777777"><TR><TD BGCOLOR="#777777" COLSPAN="2"><FONT COLOR="white"><B>operating_condition</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code">UQcode*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="interval_factor">interval_factor*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">numeric(4,2)</FONT></TD></TR></TABLE>>];
    "ref.part_category" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#777777"><TR><TD BGCOLOR="#777777" COLSPAN="2"><FONT COLOR="white"><B>part_category</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="parent_id">FK parent_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code">UQcode*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(120)</FONT></TD></TR></TABLE>>];
    "ref.season_phase" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#777777"><TR><TD BGCOLOR="#777777" COLSPAN="2"><FONT COLOR="white"><B>season_phase</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code">PK <B>code</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(80)</FONT></TD></TR></TABLE>>];
    "ref.unit_of_measure" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#777777"><TR><TD BGCOLOR="#777777" COLSPAN="2"><FONT COLOR="white"><B>unit_of_measure</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code">UQcode*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_fractional">is_fractional*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">boolean</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_iam { label=<<B>iam</B> — Identity>; style="rounded,filled"; fillcolor="#F3E5F5"; color="#8E24AA"; fontsize=14; penwidth=2;
    "iam.app_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#8E24AA"><TR><TD BGCOLOR="#8E24AA" COLSPAN="2"><FONT COLOR="white"><B>app_user</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_name">UQuser_name*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">citext</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email">UQemail*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">citext</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="full_name">full_name*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="phone">phone</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="password_hash">password_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="security_stamp">security_stamp*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_active">is_active*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="failed_login_count">failed_login_count*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="lockout_end">lockout_end</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="home_warehouse_id">home_warehouse_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_login_at">last_login_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="anonymised_at">anonymised_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamptz</FONT></TD></TR></TABLE>>];
    "iam.role" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#8E24AA"><TR><TD BGCOLOR="#8E24AA" COLSPAN="2"><FONT COLOR="white"><B>role</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code">UQcode*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="description">description</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">text</FONT></TD></TR></TABLE>>];
    "iam.user_brand" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#8E24AA"><TR><TD BGCOLOR="#8E24AA" COLSPAN="2"><FONT COLOR="white"><B>user_brand</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">PK FK <B>user_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="brand_id">PK FK <B>brand_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR></TABLE>>];
    "iam.user_role" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#8E24AA"><TR><TD BGCOLOR="#8E24AA" COLSPAN="2"><FONT COLOR="white"><B>user_role</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">PK FK <B>user_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="role_id">PK FK <B>role_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="granted_at">granted_at*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="granted_by">FK granted_by</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">uuid</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_catalog { label=<<B>catalog</B> — Inventory — catalogue>; style="rounded,filled"; fillcolor="#E3F2FD"; color="#1E88E5"; fontsize=14; penwidth=2;
    "catalog.part" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#1E88E5"><TR><TD BGCOLOR="#1E88E5" COLSPAN="2"><FONT COLOR="white"><B>part</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="brand_id">FK brand_id*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="oem_part_number">oem_part_number*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="description">description*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(300)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_id">FK category_id*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="uom_id">FK uom_id*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="weight_kg">weight_kg</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">numeric(9,3)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unit_cost">unit_cost*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">numeric(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_condition_based">is_condition_based*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_active">is_active*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamptz</FONT></TD></TR></TABLE>>];
    "catalog.part_analogue" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#1E88E5"><TR><TD BGCOLOR="#1E88E5" COLSPAN="2"><FONT COLOR="white"><B>part_analogue</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="part_id">PK FK <B>part_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="analogue_part_id">PK FK <B>analogue_part_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="scaling_factor">scaling_factor*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">numeric(5,3)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="valid_from">valid_from*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamptz</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_inventory { label=<<B>inventory</B> — Inventory — stock &amp; transfers>; style="rounded,filled"; fillcolor="#E0F2F1"; color="#00897B"; fontsize=14; penwidth=2;
    "inventory.demand_exception" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#00897B"><TR><TD BGCOLOR="#00897B" COLSPAN="2"><FONT COLOR="white"><B>demand_exception</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="movement_id">PK FK <B>movement_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="movement_occurred_at">PK FK <B>movement_occurred_at</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="reason">reason*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(300)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="detection_method">detection_method*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="flagged_by">flagged_by</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="flagged_at">flagged_at*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamptz</FONT></TD></TR></TABLE>>];
    "inventory.stock_balance" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#00897B"><TR><TD BGCOLOR="#00897B" COLSPAN="2"><FONT COLOR="white"><B>stock_balance</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="warehouse_id">PK FK <B>warehouse_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="part_id">PK FK <B>part_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="on_hand_qty">on_hand_qty*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">numeric(12,3)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="reserved_qty">reserved_qty*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">numeric(12,3)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="available_qty">available_qty</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">numeric(12,3)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_movement_at">last_movement_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamptz</FONT></TD></TR></TABLE>>];
    "inventory.stock_movement" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#00897B"><TR><TD BGCOLOR="#00897B" COLSPAN="2"><FONT COLOR="white"><B>stock_movement</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">PK <B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="occurred_at">PK <B>occurred_at</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="warehouse_id">FK warehouse_id*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="part_id">FK part_id*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="movement_type_code">FK movement_type_code*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantity">quantity*</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">numeric(12,3)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unit_cost">unit_cost</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">numeric(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="service_order_line_id">service_order_line_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="transfer_order_line_id">FK transfer_order_line_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="purchase_order_line_id">purchase_order_line_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="import_batch_id">FK import_batch_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="external_doc_ref">external_doc_ref</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="note">note</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(300)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_by">created_by</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">uuid</FONT></TD><