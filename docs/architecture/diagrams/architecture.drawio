<mxfile host="SmartSpare generator" modified="2026-11-24" version="24.0.0" type="device"><diagram id="solution-architecture" name="Solution architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Solution architecture&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="10.0" y="-50.0" width="1200.0" height="36.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=14;fontStyle=1;dashed=1;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="784.2" y="248.8" width="890.0" height="435.6" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=14;fontStyle=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1367.2" y="861.2" width="1022.0" height="251.5" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=14;fontStyle=1;dashed=1;fillColor=#F3E5F5;strokeColor=#8E24AA;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1970.2" y="632.4" width="698.0" height="185.5" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=14;fontStyle=1;fillColor=#E8F5E9;strokeColor=#43A047;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="142.2" y="632.4" width="634.0" height="203.8" as="geometry"/></mxCell><mxCell id="c7" value="&lt;TABLE BORDER=&quot;1&quot; CELLBORDER=&quot;1&quot; CELLSPACING=&quot;4&quot; CELLPADDING=&quot;5&quot; BGCOLOR=&quot;white&quot; COLOR=&quot;#999999&quot;&gt;&#10;    &lt;TR&gt;&lt;TD BORDER=&quot;0&quot; ALIGN=&quot;LEFT&quot;&gt;&lt;B&gt;Legend&lt;/B&gt;&lt;/TD&gt;&lt;/TR&gt;&#10;    &lt;TR&gt;&lt;TD STYLE=&quot;ROUNDED&quot; ALIGN=&quot;LEFT&quot;&gt;solid border = implemented&lt;/TD&gt;&lt;/TR&gt;&#10;    &lt;TR&gt;&lt;TD STYLE=&quot;ROUNDED,DASHED&quot; ALIGN=&quot;LEFT&quot;&gt;dashed border + (stage N) = planned&lt;/TD&gt;&lt;/TR&gt;&#10;    &lt;TR&gt;&lt;TD STYLE=&quot;ROUNDED&quot; BGCOLOR=&quot;#EEEEEE&quot; ALIGN=&quot;LEFT&quot;&gt;grey = external system&lt;/TD&gt;&lt;/TR&gt;&#10;    &lt;TR&gt;&lt;TD BORDER=&quot;0&quot; ALIGN=&quot;LEFT&quot;&gt;&lt;FONT POINT-SIZE=&quot;9&quot;&gt;dashed edge = planned connection&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&#10;  &lt;/TABLE&gt;" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1138.3" y="52.0" width="229.8" height="147.2" as="geometry"/></mxCell><mxCell id="c8" value="Users (browser / tablet)&lt;br&gt;Brand manager · Service engineer · Warehouse keeper&lt;br&gt;Inventory planner · Sponsor · Administrator" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEEEEE;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2045.1" y="101.4" width="318.2" height="48.5" as="geometry"/></mxCell><mxCell id="c9" value="Legacy dealer ERP&lt;br&gt;(CSV export: catalogue, demand history)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEEEEE;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1390.3" y="107.6" width="241.7" height="36.0" as="geometry"/></mxCell><mxCell id="c10" value="OEM suppliers&lt;br&gt;(purchase order files)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEEEEE;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="-0.0" y="640.4" width="134.5" height="36.0" as="geometry"/></mxCell><mxCell id="c11" value="On-call channels&lt;br&gt;Telegram · e-mail" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEEEEE;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2728.0" y="767.6" width="110.5" height="36.0" as="geometry"/></mxCell><mxCell id="c12" value="SmartSpare.Web.Client (stage 3)&lt;br&gt;Blazor WebAssembly + MudBlazor, runs in the browser&lt;br&gt;typed HTTP clients · SmartSpare.ApiContracts DTOs · no tokens" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2019.9" y="250.5" width="368.5" height="48.5" as="geometry"/></mxCell><mxCell id="c13" value="&lt;B&gt;Azure Container Apps environment (stage 4)&lt;/B&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;one image and one revision per app · internal ingress for services · ADR 0009, 0015&lt;/FONT&gt;" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1043.6" y="256.8" width="423.3" height="36.0" as="geometry"/></mxCell><mxCell id="c14" value="SmartSpare.Gateway — YARP BFF (stage 4)&lt;br&gt;external HTTPS ingress · hosts the WASM client · /bff sign-in&lt;br&gt;HttpOnly SameSite cookie + antiforgery · rate limit · /scalar + OpenAPI&lt;br&gt;swaps the cookie for a 2-min ES256 internal token (ADR 0016)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1256.3" y="350.3" width="409.8" height="62.0" as="geometry"/></mxCell><mxCell id="c15" value="&lt;TABLE BORDER=&quot;1&quot; STYLE=&quot;ROUNDED,DASHED&quot; COLOR=&quot;#1E88E5&quot; CELLBORDER=&quot;1&quot; CELLSPACING=&quot;6&quot; CELLPADDING=&quot;6&quot; BGCOLOR=&quot;white&quot;&gt;&#10;      &lt;TR&gt;&lt;TD COLSPAN=&quot;6&quot; BORDER=&quot;0&quot; ALIGN=&quot;LEFT&quot;&gt;&lt;B&gt;Six module services&lt;/B&gt; (service hosts: stage 4) — each: own image, own database login, JwtBearer for the internal token,&lt;BR ALIGN=&quot;LEFT&quot;/&gt;handler pipeline (ADR 0005), outbox / inbox (ADR 0003), DbContext + migrations. Module code is implemented; use cases come with the module's stage&lt;BR ALIGN=&quot;LEFT&quot;/&gt;&lt;/TD&gt;&lt;/TR&gt;&#10;      &lt;TR&gt;&lt;TD PORT=&quot;id&quot; BGCOLOR=&quot;#F3E5F5&quot; COLOR=&quot;#8E24AA&quot; STYLE=&quot;ROUNDED,DASHED&quot;&gt;identity&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;iam&lt;/FONT&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;use cases: stage 3&lt;/FONT&gt;&lt;/TD&gt;&lt;TD PORT=&quot;inv&quot; BGCOLOR=&quot;#E0F2F1&quot; COLOR=&quot;#00897B&quot; STYLE=&quot;ROUNDED,DASHED&quot;&gt;inventory&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;catalog · inventory · raw · staging&lt;/FONT&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;use cases: stage 5&lt;/FONT&gt;&lt;/TD&gt;&lt;TD PORT=&quot;fleet&quot; BGCOLOR=&quot;#FFF3E0&quot; COLOR=&quot;#FB8C00&quot; STYLE=&quot;ROUNDED,DASHED&quot;&gt;fleet&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;fleet&lt;/FONT&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;use cases: stage 6&lt;/FONT&gt;&lt;/TD&gt;&lt;TD PORT=&quot;proc&quot; BGCOLOR=&quot;#FCE4EC&quot; COLOR=&quot;#D81B60&quot; STYLE=&quot;ROUNDED,DASHED&quot;&gt;procurement&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;procurement&lt;/FONT&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;use cases: stage 7&lt;/FONT&gt;&lt;/TD&gt;&lt;TD PORT=&quot;fc&quot; BGCOLOR=&quot;#E8EAF6&quot; COLOR=&quot;#3949AB&quot; STYLE=&quot;ROUNDED,DASHED&quot;&gt;forecasting&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;forecast · ML.NET&lt;/FONT&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;use cases: stage 8&lt;/FONT&gt;&lt;/TD&gt;&lt;TD PORT=&quot;rep&quot; BGCOLOR=&quot;#E8F5E9&quot; COLOR=&quot;#43A047&quot; STYLE=&quot;ROUNDED,DASHED&quot;&gt;reporting&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;mart, read-only · audit jobs&lt;/FONT&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;use cases: stage 9&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&#10;    &lt;/TABLE&gt;" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1"><mxGeometry x="792.4" y="474.8" width="873.5" height="99.0" as="geometry"/></mxCell><mxCell id="c16" value="ML training job (stage 8)&lt;br&gt;Container Apps job (cron), Forecasting image" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="855.4" y="640.4" width="265.8" height="36.0" as="geometry"/></mxCell><mxCell id="c17" value="&lt;B&gt;Stateful host — Linux VM with a managed disk (stage 4)&lt;/B&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;private network of the environment · local-disk storage for the broker and Prometheus&lt;/FONT&gt;" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1984.4" y="640.4" width="437.5" height="36.0" as="geometry"/></mxCell><mxCell id="c18" value="RabbitMQ 4.4 (ADR 0017)&lt;br&gt;topic exchange per publishing module&lt;br&gt;quorum queue per consumer · delayed retry · DLX by policy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFDE7;strokeColor=#C0A000;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2313.8" y="761.3" width="346.8" height="48.5" as="geometry"/></mxCell><mxCell id="c19" value="Grafana stack (ADR 0018)&lt;br&gt;OpenTelemetry Collector → Prometheus · Loki · Tempo&lt;br&gt;Grafana dashboards and alert rules" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1978.3" y="761.3" width="313.7" height="48.5" as="geometry"/></mxCell><mxCell id="c20" value="&lt;B&gt;PostgreSQL 17 — one database, schemas owned by modules (ADR 0011)&lt;/B&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;locally Aspire / docker compose, in CI Testcontainers · Azure Database for PostgreSQL Flexible Server (stage 4)&lt;/FONT&gt;" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1"><mxGeometry x="156.3" y="640.4" width="556.0" height="36.0" as="geometry"/></mxCell><mxCell id="c21" value="ref · util · audit (Platform) │ iam │ catalog · inventory · raw · staging │ fleet │ procurement │ forecast │ mart&lt;br&gt;no FKs, JOINs or transactions across modules · outbox / inbox and __ef_migrations_history per module&lt;br&gt;triggers · functions · views · materialised views · roles and grants (SQL parts in db/sql/&amp;lt;module&amp;gt;)&lt;br&gt;one login per service (smartspare_identity … smartspare_reporting), per-module roles in stage 10" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="150.5" y="743.0" width="617.5" height="85.2" as="geometry"/></mxCell><mxCell id="c22" value="Azure Blob Storage (stages 4, 5, 8)&lt;br&gt;import files · ML.NET models · gateway key ring&lt;br&gt;Loki and Tempo data" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#555555;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1681.8" y="625.0" width="280.7" height="66.7" as="geometry"/></mxCell><mxCell id="c23" value="Azure Key Vault + Managed Identity per app (stage 4)&lt;br&gt;token signing key · broker and alerting secrets&lt;br&gt;PostgreSQL via Entra ID (stage 10)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1682.6" y="250.5" width="315.3" height="48.5" as="geometry"/></mxCell><mxCell id="c24" value="&lt;B&gt;Development, tests and delivery&lt;/B&gt;" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1731.3" y="869.2" width="217.7" height="36.0" as="geometry"/></mxCell><mxCell id="c25" value="Single-host topology — SmartSpare.Host&lt;br&gt;all six modules in one process · in-process events and Contracts queries&lt;br&gt;used locally, in unit / integration tests and CI (BFF cookie: stage 3)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1965.0" y="1056.2" width="416.5" height="48.5" as="geometry"/></mxCell><mxCell id="c26" value=".NET Aspire AppHost (local only)&lt;br&gt;PostgreSQL 17 container · telemetry dashboard&lt;br&gt;--topology services: gateway, services, RabbitMQ, Grafana (stage 4)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1761.4" y="956.5" width="395.5" height="48.5" as="geometry"/></mxCell><mxCell id="c27" value="SmartSpare.MigrationRunner&lt;br&gt;bootstrap + EF migrations in ModuleCatalog order&lt;br&gt;check-model · used by Aspire and CI" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1649.8" y="1056.2" width="292.8" height="48.5" as="geometry"/></mxCell><mxCell id="c28" value="GitHub Actions CI&lt;br&gt;build · format · check-model · tests&lt;br&gt;SQL suite on the EF-built database" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1529.5" y="956.5" width="209.5" height="48.5" as="geometry"/></mxCell><mxCell id="c29" value="Per-service CD (stage 4)&lt;br&gt;OIDC · image → Azure Container Registry&lt;br&gt;→ module migration bundle → new revision" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1375.1" y="1056.2" width="252.3" 