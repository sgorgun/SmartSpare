<mxfile host="SmartSpare generator" modified="2026-11-17" version="24.0.0" type="device"><diagram id="solution-architecture" name="Solution architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Solution architecture&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="10.0" y="-50.0" width="1200.0" height="36.0" as="geometry"/></mxCell><mxCell id="c3" value="&lt;B&gt;Azure App Service (Linux container) — one deployable&lt;/B&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=14;fontStyle=1;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="83.0" y="282.0" width="846.0" height="418.0" as="geometry"/></mxCell><mxCell id="c4" value="&lt;B&gt;Azure Database for PostgreSQL Flexible Server 17&lt;/B&gt; — one database, schemas owned by modules (ADR 0011)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=14;fontStyle=1;fillColor=#E8F5E9;strokeColor=#43A047;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="759.0" y="730.0" width="820.0" height="99.5" as="geometry"/></mxCell><mxCell id="c5" value="&lt;B&gt;Modules&lt;/B&gt; — each: Domain/ · Features/&amp;lt;UseCase&amp;gt;/ · Infrastructure/ (DbContext, migrations) + Contracts" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=14;fontStyle=1;fillColor=#FFFFFF;strokeColor=#1E88E5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="91.0" y="501.0" width="830.0" height="83.0" as="geometry"/></mxCell><mxCell id="c6" value="&lt;B&gt;Local development only&lt;/B&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=14;fontStyle=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=2;" vertex="1