<mxfile host="SmartSpare generator" modified="2026-11-17" version="24.0.0" type="device"><diagram id="solution-architecture" name="Solution architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Solution architecture&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="10.0" y="-50.0" width="1200.0" height="36.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=14;fontStyle=1;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="581.0" y="222.0" width="1060.0" height="392.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=14;fontStyle=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1985.0" y="648.0" width="670.0" height="243.5" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=14;fontStyle=1;fillColor=#E8F5E9;strokeColor=#43A047;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1343.0" y="648.0" width="634.0" height="153.5" as="geometry"/></mxCell><mxCell id="c6" value="&lt;TABLE BORDER=&quot;1&quot; CELLBORDER=&quot;1&quot; CELLSPACING=&quot;4&quot; CELLPADDING=&quot;5&quot; BGCOLOR=&quot;white&quot; COLOR=&quot;#999999&quot;&gt;&#10;    &lt;TR&gt;&lt;TD BORDER=&quot;0&quot; ALIGN=&quot;LEFT&quot;&gt;&lt;B&gt;Legend&lt;/B&gt;&lt;/TD&gt;&lt;/TR&gt;&#10;    &lt;TR&gt;&lt;TD STYLE=&quot;ROUNDED&quot; ALIGN=&quot;LEFT&quot;&gt;solid border = implemented&lt;/TD&gt;&lt;/TR&gt;&#10;    &lt;TR&gt;&lt;TD STYLE=&quot;ROUNDED,DASHED&quot; ALIGN=&quot;LEFT&quot;&gt;dashed border + (stage N) = planned&lt;/TD&gt;&lt;/TR&gt;&#10;    &lt;TR&gt;&lt;TD STYLE=&quot;ROUNDED&quot; BGCOLOR=&quot;#EEEEEE&quot; ALIGN=&quot;LEFT&quot;&gt;grey = external system&lt;/TD&gt;&lt;/TR&gt;&#10;    &lt;TR&gt;&lt;TD BORDER=&quot;0&quot; ALIGN=&quot;LEFT&quot;&gt;&lt;FONT POINT-SIZE=&quot;9&quot;&gt;dashed edge = planned connection&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&#10;  &lt;/TABLE&gt;" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1"><mxGeometry x="0.0" y="40.0" width="230.0" height="140.0" as="geometry"/></mxCell><mxCell id="c7" value="Users (browser / tablet)&lt;br&gt;Brand manager · Service engineer · Warehouse keeper&lt;br&gt;Inventory planner · Sponsor · Administrator" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEEEEE;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="252.5" y="88.0" width="319.0" height="44.0" as="geometry"/></mxCell><mxCell id="c8" value="Legacy dealer ERP&lt;br&gt;(CSV export: catalogue, demand history)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEEEEE;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1649.0" y="230.0" width="242.0" height="36.0" as="geometry"/></mxCell><mxCell id="c9" value="OEM suppliers&lt;br&gt;(purchase order files)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEEEEE;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="958.5" y="656.0" width="135.0" height="36.0" as="geometry"/></mxCell><mxCell id="c10" value="SmartSpare.Web.Client (stage 3)&lt;br&gt;Blazor WebAssembly + MudBlazor, runs in the browser&lt;br&gt;typed HTTP clients · SmartSpare.ApiContracts DTOs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="251.5" y="226.0" width="321.0" height="44.0" as="geometry"/></mxCell><mxCell id="c11" value="&lt;B&gt;SmartSpare.Host process — one deployable&lt;/B&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;container on Azure App Service (stage 9)&lt;/FONT&gt;" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1301.5" y="230.0" width="287.0" height="36.0" as="geometry"/></mxCell><mxCell id="c12" value="SmartSpare.Host — HTTP API&lt;br&gt;ASP.NET Core 10 minimal APIs · OpenAPI · ProblemDetails&lt;br&gt;/health/live, /health/ready · module installers" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1277.5" y="316.0" width="335.0" height="44.0" as="geometry"/></mxCell><mxCell id="c13" value="BFF (stage 3)&lt;br&gt;HttpOnly SameSite cookie + antiforgery&lt;br&gt;claims-based policies · serves the WASM client" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="782.5" y="316.0" width="275.0" height="44.0" as="geometry"/></mxCell><mxCell id="c14" value="Command / query pipeline (ADR 0005)&lt;br&gt;own ICommandHandler / IQueryHandler instead of MediatR&lt;br&gt;decorators: logging → validation → transaction (unit of work)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="589.0" y="412.0" width="350.0" height="44.0" as="geometry"/></mxCell><mxCell id="c15" value="Outbox / Inbox (ADR 0003)&lt;br&gt;per-module outbox_message / inbox_message,&lt;br&gt;dispatcher with FOR UPDATE SKIP LOCKED, idempotent inbox&lt;br&gt;first integration events (stages 5–7)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFDE7;strokeColor=#C0A000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="983.0" y="406.0" width="356.0" height="56.0" as="geometry"/></mxCell><mxCell id="c16" value="Background jobs, Quartz.NET (from stage 4)&lt;br&gt;reservation expiry · mart refresh · audit purge&lt;br&gt;ML training (stage 7)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1361.0" y="412.0" width="272.0" height="44.0" as="geometry"/></mxCell><mxCell id="c17" value="&lt;TABLE BORDER=&quot;1&quot; STYLE=&quot;ROUNDED&quot; COLOR=&quot;#1E88E5&quot; CELLBORDER=&quot;1&quot; CELLSPACING=&quot;6&quot; CELLPADDING=&quot;6&quot; BGCOLOR=&quot;white&quot;&gt;&#10;      &lt;TR&gt;&lt;TD COLSPAN=&quot;6&quot; BORDER=&quot;0&quot; ALIGN=&quot;LEFT&quot;&gt;&lt;B&gt;Modules&lt;/B&gt; — each: DbContext, migrations, Contracts, installer (implemented)&lt;BR ALIGN=&quot;LEFT&quot;/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;Domain/ aggregates and Features/ use cases come with the module's stage (ADR 0013)&lt;/FONT&gt;&lt;BR ALIGN=&quot;LEFT&quot;/&gt;&lt;/TD&gt;&lt;/TR&gt;&#10;      &lt;TR&gt;&lt;TD PORT=&quot;id&quot; BGCOLOR=&quot;#F3E5F5&quot; COLOR=&quot;#8E24AA&quot; STYLE=&quot;ROUNDED&quot;&gt;Identity&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;iam&lt;/FONT&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;use cases: stage 3&lt;/FONT&gt;&lt;/TD&gt;&lt;TD PORT=&quot;inv&quot; BGCOLOR=&quot;#E0F2F1&quot; COLOR=&quot;#00897B&quot; STYLE=&quot;ROUNDED&quot;&gt;Inventory&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;catalog · inventory · raw · staging&lt;/FONT&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;use cases: stage 4&lt;/FONT&gt;&lt;/TD&gt;&lt;TD PORT=&quot;fleet&quot; BGCOLOR=&quot;#FFF3E0&quot; COLOR=&quot;#FB8C00&quot; STYLE=&quot;ROUNDED&quot;&gt;Fleet&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;fleet&lt;/FONT&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;use cases: stage 5&lt;/FONT&gt;&lt;/TD&gt;&lt;TD PORT=&quot;proc&quot; BGCOLOR=&quot;#FCE4EC&quot; COLOR=&quot;#D81B60&quot; STYLE=&quot;ROUNDED&quot;&gt;Procurement&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;procurement&lt;/FONT&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;use cases: stage 6&lt;/FONT&gt;&lt;/TD&gt;&lt;TD PORT=&quot;fc&quot; BGCOLOR=&quot;#E8EAF6&quot; COLOR=&quot;#3949AB&quot; STYLE=&quot;ROUNDED&quot;&gt;Forecasting&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;forecast&lt;/FONT&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;use cases: stage 7 (+ ML.NET)&lt;/FONT&gt;&lt;/TD&gt;&lt;TD PORT=&quot;rep&quot; BGCOLOR=&quot;#E8F5E9&quot; COLOR=&quot;#43A047&quot; STYLE=&quot;ROUNDED&quot;&gt;Reporting&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;mart, read-only&lt;/FONT&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;use cases: stage 8&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&#10;    &lt;/TABLE&gt;" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1"><mxGeometry x="589.5" y="508.0" width="805.0" height="98.0" as="geometry"/></mxCell><mxCell id="c18" value="&lt;B&gt;PostgreSQL 17 — one database, schemas owned by modules (ADR 0011)&lt;/B&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;locally Aspire / docker compose, in CI Testcontainers · Azure Database for PostgreSQL Flexible Server (stage 9)&lt;/FONT&gt;" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1356.5" y="656.0" width="557.0" height="36.0" as="geometry"/></mxCell><mxCell id="c19" value="ref · util · audit (Platform) │ iam │ catalog · inventory · raw · staging │ fleet │ procurement │ forecast │ mart&lt;br&gt;no FKs, JOINs or transactions across modules · outbox / inbox and __ef_migrations_history per module&lt;br&gt;triggers · functions · views · materialised views · roles and grants (SQL parts in db/sql/&amp;lt;module&amp;gt;)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1351.0" y="733.0" width="618.0" height="60.5" as="geometry"/></mxCell><mxCell id="c20" value="Azure Blob Storage (stages 4, 7)&lt;br&gt;import files · ML.NET model versions" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#555555;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1115.5" y="652.0" width="219.0" height="44.0" as="geometry"/></mxCell><mxCell id="c21" value="Azure Key Vault + Managed Identity (stage 9)&lt;br&gt;secrets · PostgreSQL via Entra ID" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1670.0" y="320.0" width="270.0" height="36.0" as="geometry"/></mxCell><mxCell id="c22" value="Application Insights (stage 9)&lt;br&gt;OpenTelemetry export" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1655.0" y="416.0" width="178.0" height="36.0" as="geometry"/></mxCell><mxCell id="c23" value="&lt;B&gt;Development and delivery&lt;/B&gt;" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2277.5" y="656.0" width="179.0" height="36.0" as="geometry"/></mxCell><mxCell id="c24" value=".NET Aspire AppHost (local only)&lt;br&gt;PostgreSQL 17 container · telemetry dashboard" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2360.5" y="745.2" width="279.0" height="36.0" as="geometry"/></mxCell><mxCell id="c25" value="SmartSpare.MigrationRunner&lt;br&gt;bootstrap + EF migrations in ModuleCatalog order&lt;br&gt;check-model · used by Aspire and CI" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2353.5" y="839.5" width="293.0" height="44.0" as="geometry"/></mxCell><mxCell id="c26" value="GitHub Actions CI&lt;br&gt;build · format · check-model · tests&lt;br&gt;SQL suite on the EF-built database" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2128.0" y="741.3" width="210.0" height="44.0" as="geometry"/></mxCell><mxCell id="c27" value="Deployment (stage 9)&lt;br&gt;OIDC sign-in · EF migration bundle per context&lt;br&gt;→ PostgreSQL as smartspare_migrator, then the container" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1993.0" y="839.5" width="338.0" height="44.0" as="geometry"/></mxCell><mxCell id="c28" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="CSV upload (stage 4)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c8" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="REST/JSON + cookie" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c10" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="secrets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c12" target="c21"><mxGeometry relative="1" as