<mxfile host="SmartSpare generator" modified="2026-11-24" version="24.0.0" type="device"><diagram id="solution-architecture" name="Solution architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Solution architecture&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="10.0" y="-50.0" width="1200.0" height="36.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=14;fontStyle=1;dashed=1;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1464.5" y="255.5" width="890.0" height="473.4" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=14;fontStyle=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="707.5" y="899.4" width="1008.0" height="278.5" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=14;fontStyle=1;fillColor=#E8F5E9;strokeColor=#43A047;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2362.5" y="670.6" width="792.0" height="203.8" as="geometry"/></mxCell><mxCell id="c6" value="&lt;TABLE BORDER=&quot;1&quot; CELLBORDER=&quot;1&quot; CELLSPACING=&quot;4&quot; CELLPADDING=&quot;5&quot; BGCOLOR=&quot;white&quot; COLOR=&quot;#999999&quot;&gt;&#10;    &lt;TR&gt;&lt;TD BORDER=&quot;0&quot; ALIGN=&quot;LEFT&quot;&gt;&lt;B&gt;Legend&lt;/B&gt;&lt;/TD&gt;&lt;/TR&gt;&#10;    &lt;TR&gt;&lt;TD STYLE=&quot;ROUNDED&quot; ALIGN=&quot;LEFT&quot;&gt;solid border = implemented&lt;/TD&gt;&lt;/TR&gt;&#10;    &lt;TR&gt;&lt;TD STYLE=&quot;ROUNDED,DASHED&quot; ALIGN=&quot;LEFT&quot;&gt;dashed border + (stage N) = planned&lt;/TD&gt;&lt;/TR&gt;&#10;    &lt;TR&gt;&lt;TD STYLE=&quot;ROUNDED&quot; BGCOLOR=&quot;#EEEEEE&quot; ALIGN=&quot;LEFT&quot;&gt;grey = external system&lt;/TD&gt;&lt;/TR&gt;&#10;    &lt;TR&gt;&lt;TD BORDER=&quot;0&quot; ALIGN=&quot;LEFT&quot;&gt;&lt;FONT POINT-SIZE=&quot;9&quot;&gt;dashed edge = planned connection&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&#10;  &lt;/TABLE&gt;" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1"><mxGeometry x="816.6" y="52.0" width="229.8" height="147.2" as="geometry"/></mxCell><mxCell id="c7" value="Users (browser / tablet)&lt;br&gt;Brand manager · Service engineer · Warehouse keeper&lt;br&gt;Inventory planner · Sponsor · Administrator" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEEEEE;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1068.4" y="101.4" width="318.2" height="48.5" as="geometry"/></mxCell><mxCell id="c8" value="Legacy dealer ERP&lt;br&gt;(CSV export: catalogue, demand history)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEEEEE;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2040.6" y="107.6" width="241.7" height="36.0" as="geometry"/></mxCell><mxCell id="c9" value="OEM suppliers&lt;br&gt;(purchase order files)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEEEEE;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1090.2" y="678.6" width="134.5" height="36.0" as="geometry"/></mxCell><mxCell id="c10" value="On-call channels&lt;br&gt;Telegram · e-mail" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEEEEE;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="836.3" y="678.6" width="110.5" height="36.0" as="geometry"/></mxCell><mxCell id="c11" value="SmartSpare.Web.Client&lt;br&gt;Blazor WebAssembly + MudBlazor, runs in the browser, prerendered by its host&lt;br&gt;sign-in page · menu by policy · typed HTTP clients with antiforgery&lt;br&gt;SmartSpare.ApiContracts DTOs only · no tokens in the browser" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="998.6" y="250.5" width="457.7" height="62.0" as="geometry"/></mxCell><mxCell id="c12" value="&lt;B&gt;Azure Container Apps environment (stage 4)&lt;/B&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;one image and one revision per app · every app scales to zero · warm-up before demos · ADR 0009, 0015&lt;/FONT&gt;" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1587.6" y="263.5" width="529.7" height="36.0" as="geometry"/></mxCell><mxCell id="c13" value="SmartSpare.Gateway — YARP BFF (stage 4)&lt;br&gt;external HTTPS ingress · hosts the WASM client · /bff sign-in&lt;br&gt;HttpOnly SameSite cookie + antiforgery · rate limit · /scalar + OpenAPI&lt;br&gt;swaps the cookie for a 2-min ES256 internal token (ADR 0016)&lt;br&gt;cookie scheme only · never routes /internal · scales to zero" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1704.6" y="363.7" width="409.8" height="75.5" as="geometry"/></mxCell><mxCell id="c14" value="&lt;TABLE BORDER=&quot;1&quot; STYLE=&quot;ROUNDED,DASHED&quot; COLOR=&quot;#1E88E5&quot; CELLBORDER=&quot;1&quot; CELLSPACING=&quot;6&quot; CELLPADDING=&quot;6&quot; BGCOLOR=&quot;white&quot;&gt;&#10;      &lt;TR&gt;&lt;TD COLSPAN=&quot;6&quot; BORDER=&quot;0&quot; ALIGN=&quot;LEFT&quot;&gt;&lt;B&gt;Six module services&lt;/B&gt; (service hosts: stage 4) — each: own image, own database login, JwtBearer only, scale to zero (woken by HTTP or its queues),&lt;BR ALIGN=&quot;LEFT&quot;/&gt;handler pipeline (ADR 0005), outbox / inbox (ADR 0003), DbContext + migrations. Module code is implemented; use cases come with the module's stage&lt;BR ALIGN=&quot;LEFT&quot;/&gt;&lt;/TD&gt;&lt;/TR&gt;&#10;      &lt;TR&gt;&lt;TD PORT=&quot;id&quot; BGCOLOR=&quot;#F3E5F5&quot; COLOR=&quot;#8E24AA&quot; STYLE=&quot;ROUNDED,DASHED&quot;&gt;identity&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;iam&lt;/FONT&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;sign-in, session checks: done&lt;/FONT&gt;&lt;/TD&gt;&lt;TD PORT=&quot;inv&quot; BGCOLOR=&quot;#E0F2F1&quot; COLOR=&quot;#00897B&quot; STYLE=&quot;ROUNDED,DASHED&quot;&gt;inventory&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;catalog · inventory · raw · staging&lt;/FONT&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;use cases: stage 5&lt;/FONT&gt;&lt;/TD&gt;&lt;TD PORT=&quot;fleet&quot; BGCOLOR=&quot;#FFF3E0&quot; COLOR=&quot;#FB8C00&quot; STYLE=&quot;ROUNDED,DASHED&quot;&gt;fleet&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;fleet&lt;/FONT&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;use cases: stage 6&lt;/FONT&gt;&lt;/TD&gt;&lt;TD PORT=&quot;proc&quot; BGCOLOR=&quot;#FCE4EC&quot; COLOR=&quot;#D81B60&quot; STYLE=&quot;ROUNDED,DASHED&quot;&gt;procurement&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;procurement&lt;/FONT&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;use cases: stage 7&lt;/FONT&gt;&lt;/TD&gt;&lt;TD PORT=&quot;fc&quot; BGCOLOR=&quot;#E8EAF6&quot; COLOR=&quot;#3949AB&quot; STYLE=&quot;ROUNDED,DASHED&quot;&gt;forecasting&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;forecast · ML.NET&lt;/FONT&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;use cases: stage 8&lt;/FONT&gt;&lt;/TD&gt;&lt;TD PORT=&quot;rep&quot; BGCOLOR=&quot;#E8F5E9&quot; COLOR=&quot;#43A047&quot; STYLE=&quot;ROUNDED,DASHED&quot;&gt;reporting&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;mart, read-only · audit jobs&lt;/FONT&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;use cases: stage 9&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&#10;    &lt;/TABLE&gt;" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1472.7" y="501.7" width="873.5" height="99.0" as="geometry"/></mxCell><mxCell id="c15" value="Container Apps jobs, cron (stage 4+)&lt;br&gt;reservation expiry · mart refresh · audit purge&lt;br&gt;broker metrics · ML training (stage 8)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2074.6" y="672.3" width="271.7" height="48.5" as="geometry"/></mxCell><mxCell id="c16" value="CloudAMQP — RabbitMQ, free Little Lemur plan (stage 4, ADR 0017)&lt;br&gt;topic exchange per publishing module · durable queue per consumer&lt;br&gt;one dead-letter queue per module · 1 connection per service · ≤ 100 queues" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEEEEE;strokeColor=#555555;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="0.0" y="672.3" width="439.0" height="48.5" as="geometry"/></mxCell><mxCell id="c17" value="Grafana Cloud Free (stage 4, ADR 0018)&lt;br&gt;Prometheus-compatible metrics · Loki · Tempo · Grafana&lt;br&gt;dashboards and alert rules as code · 14-day retention" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEEEEE;strokeColor=#555555;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="460.6" y="672.3" width="325.7" height="48.5" as="geometry"/></mxCell><mxCell id="c18" value="&lt;B&gt;PostgreSQL 17 — one database, schemas owned by modules (ADR 0011)&lt;/B&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;locally Aspire / docker compose, in CI Testcontainers · Azure Database for PostgreSQL Flexible Server (stage 4)&lt;/FONT&gt;" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2480.5" y="678.6" width="556.0" height="36.0" as="geometry"/></mxCell><mxCell id="c19" value="ref · util · audit (Platform) │ iam │ catalog · inventory · raw · staging │ fleet │ procurement │ forecast │ mart&lt;br&gt;no FKs, JOINs or transactions across modules · outbox / inbox and __ef_migrations_history per module&lt;br&gt;triggers · functions · views · materialised views · roles and grants (SQL parts in db/sql/&amp;lt;module&amp;gt;)&lt;br&gt;one login per service (smartspare_identity … smartspare_reporting), pool ≤ 4 each (B1ms: 35 connections), per-module roles in stage 10" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2371.0" y="781.2" width="775.0" height="85.2" as="geometry"/></mxCell><mxCell id="c20" value="Azure Blob Storage (stages 4, 5, 8)&lt;br&gt;import files · ML.NET models&lt;br&gt;gateway Data Protection key ring" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#555555;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1246.4" y="663.2" width="210.2" height="66.7" as="geometry"/></mxCell><mxCell id="c21" value="Azure Key Vault + Managed Identity per app (stage 4)&lt;br&gt;token signing key · CloudAMQP URL · Grafana Cloud token&lt;br&gt;PostgreSQL via Entra ID (stage 10)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2363.0" y="257.2" width="337.0" height="48.5" as="geometry"/></mxCell><mxCell id="c22" value="&lt;B&gt;Development, tests and delivery&lt;/B&gt;" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1104.6" y="907.4" width="217.7" height="36.0" as="geometry"/></mxCell><mxCell id="c23" value="Single-host topology — SmartSpare.Host&lt;br&gt;HTTP API + BFF: /bff sign-in, HttpOnly cookie, antiforgery, strict CSP&lt;br&gt;hosts the WASM client · all six modules in one process&lt;br&gt;in-process events and Contracts queries · used locally, in tests and CI" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1305.4" y="1107.9" width="402.2" height="62.0" as="geometry"/></mxCell><mxCell id="c24" value=".NET Aspire AppHost (local only)&lt;br&gt;PostgreSQL 17 container · telemetry dashboard&lt;br&gt;--topology services (stage 4): gateway, services, RabbitMQ,&lt;br&gt;Collector · Prometheus · Loki · Tempo · Grafana (self-hosted)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1115.0" y="994.7" width="349.0" height="62.0" as="geometry"/></mxCell><mxCell id="c25" value="SmartSpare.MigrationRunner&lt;br&gt;bootstrap + EF migrations in ModuleCatalog order&lt;br&gt;check-model · used by Aspire and CI" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="990.1" y="1114.7" width="292.8" height="48.5" as="geometry"/></mxCell><mxCell id="c26" value="GitHub Actions CI (tools/check.sh)&lt;br&gt;build · format · check-model · tests&lt;br&gt;SQL suite on the EF-built database&lt;br&gt;Playwright smoke test in Chromium" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="880.2" y="994.7" width="212.5" height="62.0" as="geometry"/></mxCell><mxCell id="c27" value="Per-service CD (stage 4)&lt;br&gt;OIDC · image → Azure Container Registry&lt;br&gt;→ module migration bundle → new revision" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="715.4" y="1114.7" width="252.3" height="48.5" as="geometry"/></mxCell><mxCell id="c28" value="starts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;" edge="1" parent="1" source="c24" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="runs before the host" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="runs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;" edge="1" parent="1" source="c26" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="when green" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;" edge="1" parent="1" source="c7" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="REST/JSON + HttpOnly cookie" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="/api/v1/{module} + internal token&lt;br&gt; /internal credential checks → identity" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="CSV upload (stage 5)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c8" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="AMQPS: publish with confirms&lt;br&gt; consume into inbox" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="login per service" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c14" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c15" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c39" value="PO export (stage 7)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c14" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="models (stage 8)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c14" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c41" value="secrets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c13" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c42" value="OTLP, direct export" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c14" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c43" value="alerts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c17" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c27" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c45" value="migrations" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;" edge="1" parent="1" source="c25" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c46" value="smartspare_api" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;" edge="1" parent="1" source="c23" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
