lth/ready" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="131.0" y="313.0" width="420.0" height="56.0" as="geometry"/></mxCell><mxCell id="c13" value="Command / query pipeline (BuildingBlocks, ADR 0005)&lt;br&gt;own ICommandHandler / IQueryHandler instead of MediatR&lt;br&gt;decorators: logging → validation (FluentValidation) → transaction (unit of work)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="133.5" y="419.0" width="451.0" height="44.0" as="geometry"/></mxCell><mxCell id="c14" value="Identity&lt;br&gt;(iam)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=10;" vertex="1" parent="1"><mxGeometry x="99.5" y="536.0" width="59.0" height="36.0" as="geometry"/></mxCell><mxCell id="c15" value="Inventory&lt;br&gt;(catalog, inventory,&lt;br&gt;raw, staging)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E0F2F1;strokeColor=#00897B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="208.5" y="532.0" width="125.0" height="44.0" as="geometry"/></mxCell><mxCell id="c16" value="Fleet&lt;br&gt;(fleet)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF3E0;strokeColor=#FB8C00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="383.0" y="536.0" width="54.0" height="36.0" as="geometry"/></mxCell><mxCell id="c17" value="Procurement&lt;br&gt;(procurement)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FCE4EC;strokeColor=#D81B60;fontSize=10;" vertex="1" parent="1"><mxGeometry x="487.0" y="536.0" width="96.0" height="36.0" as="geometry"/></mxCell><mxCell id="c18" value="Forecasting&lt;br&gt;(forecast, ML.NET)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8EAF6;strokeColor=#3949AB;fontSize=10;" vertex="1" parent="1"><mxGeometry x="632.5" y="536.0" width="119.0" height="36.0" as="geometry"/></mxCell><mxCell id="c19" value="Reporting&lt;br&gt;(mart, read-only)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F5E9;strokeColor=#43A047;fontSize=10;" vertex="1" parent="1"><mxGeometry x="801.0" y="536.0" width="112.0" height="36.0" as="geometry"/></mxCell><mxCell id="c20" value="Outbox / Inbox (BuildingBlocks, ADR 0003)&lt;br&gt;integration events written in the module's transaction,&lt;br&gt;dispatched with FOR UPDATE SKIP LOCKED, idempotent consumers&lt;br&gt;(in-process now; Azure Service Bus after a split)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFDE7;strokeColor=#C0A000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="155.0" y="636.0" width="388.0" height="56.0" as="geometry"/></mxCell><mxCell id="c21" value="Background jobs (Quartz.NET, clustered)&lt;br&gt;mart refresh · reservation expiry · audit purge · ML training" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="576.5" y="323.0" width="345.0" height="36.0" as="geometry"/></mxCell><mxCell id="c22" value="ref · util · audit (Platform) │ iam │ catalog · inventory · raw · staging │ fleet │ procurement │ forecast │ mart&lt;br&gt;no FKs, JOINs or transactions across modules · outbox_message / inbox_message and __ef_migrations_history per module&lt;br&gt;triggers · functions · views · materialised views · roles and grants (SQL parts in db/sql/&amp;lt;module&amp;gt;)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="824.5" y="761.0" width="689.0" height="60.5" as="geometry"/></mxCell><mxCell id="c23" value="Azure Blob Storage&lt;br&gt;(import files, ML.NET model versions)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="109