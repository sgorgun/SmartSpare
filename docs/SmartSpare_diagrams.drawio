uot;&gt;&#10;    &lt;TR&gt;&lt;TD BORDER=&quot;0&quot; ALIGN=&quot;LEFT&quot;&gt;&lt;B&gt;Legend&lt;/B&gt;&lt;/TD&gt;&lt;/TR&gt;&#10;    &lt;TR&gt;&lt;TD STYLE=&quot;ROUNDED&quot; ALIGN=&quot;LEFT&quot;&gt;solid border = implemented&lt;/TD&gt;&lt;/TR&gt;&#10;    &lt;TR&gt;&lt;TD STYLE=&quot;ROUNDED,DASHED&quot; ALIGN=&quot;LEFT&quot;&gt;dashed border + (stage N) = planned&lt;/TD&gt;&lt;/TR&gt;&#10;    &lt;TR&gt;&lt;TD STYLE=&quot;ROUNDED&quot; BGCOLOR=&quot;#EEEEEE&quot; ALIGN=&quot;LEFT&quot;&gt;grey = external system&lt;/TD&gt;&lt;/TR&gt;&#10;    &lt;TR&gt;&lt;TD BORDER=&quot;0&quot; ALIGN=&quot;LEFT&quot;&gt;&lt;FONT POINT-SIZE=&quot;9&quot;&gt;dashed edge = planned connection&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&#10;  &lt;/TABLE&gt;" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1"><mxGeometry x="862.6" y="52.0" width="200.5" height="146.5" as="geometry"/></mxCell><mxCell id="c7" value="Users (browser / tablet)&lt;br&gt;Brand manager · Service engineer · Warehouse keeper&lt;br&gt;Inventory planner · Sponsor · Administrator" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEEEEE;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1084.8" y="101.0" width="282.2" height="48.5" as="geometry"/></mxCell><mxCell id="c8" value="Legacy dealer ERP&lt;br&gt;(CSV export: catalogue, demand history)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEEEEE;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2019.0" y="107.2" width="211.8" height="36.0" as="geometry"/></mxCell><mxCell id="c9" value="OEM suppliers&lt;br&gt;(purchase order files)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEEEEE;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1091.9" y="683.3" width="118.0" height="36.0" as="geometry"/></mxCell><mxCell id="c10" value="On-call channels&lt;br&gt;Telegram · e-mail" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEEEEE;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="856.3" y="683.3" width="99.3" height="36.0" as="geometry"/></mxCell><mxCell id="c11" value="SmartSpare.Web.Client&lt;br&gt;Blazor WebAssembly + MudBlazor, runs in the browser, prerendered by its host&lt;br&gt;sign-in page · menu by policy · typed HTTP clients with antiforgery&lt;br&gt;SmartSpare.ApiContracts DTOs only · no tokens in the browser" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1027.8" y="249.0" width="396.3" height="62.0" as="geometry"/></mxCell><mxCell id="c12" value="&lt;B&gt;Azure Container Apps environment (stage 10)&lt;/B&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;one image and one revision per app · every app scales to zero · warm-up before demos · ADR 0009, 0015&lt;BR/&gt;Bicep and images ready since stage 4; the apps themselves run today in the local services topology and the CI topology test&lt;/FONT&gt;" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1520.7" y="260.5" width="560.5" height="39.0" as="geometry"/></mxCell><mxCell id="c13" value="SmartSpare.Gateway — YARP BFF&lt;br&gt;external HTTPS ingress · hosts the WASM client · /bff sign-in&lt;br&gt;HttpOnly SameSite cookie + antiforgery · rate limit · /scalar + OpenAPI&lt;br&gt;swaps the cookie for a 2-min ES256 internal token (ADR 0016)&lt;br&gt;cookie scheme only · never routes /internal · scales to zero" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1690.8" y="361.5" width="354.2" height="75.5" as="geometry"/></mxCell><mxCell id="c14" value="&lt;TABLE BORDER=&quot;1&quot; STYLE=&quot;ROUNDED&quot; COLOR=&quot;#1E88E5&quot; CELLBORDER=&quot;1&quot; CELLSPACING=&quot;6&quot; CELLPADDING=&quot;6&quot; BGCOLOR=&quot;white&quot;&gt;&#10;      &lt;TR&gt;&lt;TD COLSPAN=&quot;6&quot; BORDER=&quot;0&quot; ALIGN=&quot;LEFT&quot;&gt;&lt;B&gt;Six module services&lt;/B&gt; (service hosts done in stage 4) — each: own image, own database login, JwtBearer only, scale to zero (woken by HTTP or its queues),&lt;BR ALIGN=&quot;LEFT&quot;/&gt;handler pipeline (ADR 0005), outbox / inbox (ADR 0003), DbContext + migrations. Module code is implemented; use cases come with the module's stage&lt;BR ALIGN=&quot;LEFT&quot;/&gt;&lt;/TD&gt;&lt;/TR&gt;&#10;      &lt;TR&gt;&lt;TD PORT=&quot;id&quot; BGCOLOR=&quot;#F3E5F5&quot; COLOR=&quot;#8E24AA&quot; STYLE=&quot;ROUNDED&quot;&gt;identity&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;iam&lt;/FONT&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;sign-in, session checks: done&lt;/FONT&gt;&lt;/TD&gt;&lt;TD PORT=&quot;inv&quot; BGCOLOR=&quot;#E0F2F1&quot; COLOR=&quot;#00897B&quot; STYLE=&quot;ROUNDED&quot;&gt;inventory&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;catalog · inventory · raw · staging&lt;/FONT&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;parts and warehouse reads: done&lt;/FONT&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;use cases: stage 5&lt;/FONT&gt;&lt;/TD&gt;&lt;TD PORT=&quot;fleet&quot; BGCOLOR=&quot;#FFF3E0&quot; COLOR=&quot;#FB8C00&quot; STYLE=&quot;ROUNDED&quot;&gt;fleet&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;fleet&lt;/FONT&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;use cases: stage 6&lt;/FONT&gt;&lt;/TD&gt;&lt;TD PORT=&quot;proc&quot; BGCOLOR=&quot;#FCE4EC&quot; COLOR=&quot;#D81B60&quot; STYLE=&quot;ROUNDED&quot;&gt;procurement&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;procurement&lt;/FONT&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;use cases: stage 7&lt;/FONT&gt;&lt;/TD&gt;&lt;TD PORT=&quot;fc&quot; BGCOLOR=&quot;#E8EAF6&quot; COLOR=&quot;#3949AB&quot; STYLE=&quot;ROUNDED&quot;&gt;forecasting&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;forecast · ML.NET&lt;/FONT&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;use cases: stage 8&lt;/FONT&gt;&lt;/TD&gt;&lt;TD PORT=&quot;rep&quot; BGCOLOR=&quot;#E8F5E9&quot; COLOR=&quot;#43A047&quot; STYLE=&quot;ROUNDED&quot;&gt;reporting&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;mart, read-only · audit jobs · broker metrics job&lt;/FONT&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;use cases: stage 9&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&#10;    &lt;/TABLE&gt;" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1439.8" y="498.0" width="856.2" height="109.0" as="geometry"/></mxCell><mxCell id="c15" value="Container Apps jobs, cron (stage 10)&lt;br&gt;reservation expiry · mart refresh · audit purge&lt;br&gt;broker metrics (runs on demand today) · ML training (stage 8)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1985.5" y="677.1" width="310.8" height="48.5" as="geometry"/></mxCell><mxCell id="c16" value="CloudAMQP — RabbitMQ, free Little Lemur plan (ADR 0017, 0021, 0023)&lt;br&gt;topic exchange per publishing module · quorum queue per consumer&lt;br&gt;one dead-letter queue per module · 1 connection per service · ≤ 100 queues&lt;br&gt;used by the local services topology; RabbitMQ 4.4 container by default" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEEEEE;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="0.0" y="670.3" width="379.7" height="62.0" as="geometry"/></mxCell><mxCell id="c17" value="Grafana Cloud Free (ADR 0018, 0023)&lt;br&gt;Prometheus-compatible metrics · Loki · Tempo · Grafana&lt;br&gt;5 dashboards and 7 alert rules as code (Terraform) · 14-day retention" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEEEEE;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="401.5" y="677.1" width="346.8" height="48.5" as="geometry"/></mxCell><mxCell id="c18" value="&lt;B&gt;PostgreSQL 17 — one database, schemas owned by modules (ADR 0011)&lt;/B&gt;&lt;BR/&gt;&lt;FONT POINT-SIZE=&quot;10&quot;&gt;locally Aspire / docker compose, in CI Testcontainers · Azure Database for PostgreSQL Flexible Server (stage 10)&lt;/FONT&gt;" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2398.0" y="683.3" width="511.7" height="36.0" as="geometry"/></mxCell><mxCell id="c19" value="ref · util · audit (Platform) │ iam │ catalog · inventory · raw · staging │ fleet │ procurement │ forecast │ mart&lt;br&gt;no FKs, JOINs or transactions across modules · outbox / inbox and __ef_migrations_history per module&lt;br&gt;triggers · functions · views · materialised views · roles and grants (SQL parts in db/sql/&amp;lt;module&amp;gt;)&lt;br&gt;one login per service (smartspare_identity … smartspare_reporting), pool ≤ 4 each (B1ms: 35 connections), per-module roles in stage 10" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2319.7" y="785.2" width="668.5" height="85.2" as="geometry"/></mxCell><mxCell id="c20" value="Azure Blob Storage (stages 5, 8, 10)&lt;br&gt;import files · ML.NET models&lt;br&gt;gateway Data Protection key ring" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#555555;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1232.2" y="668.0" width="191.5" height="66.7" as="geometry"/></mxCell><mxCell id="c21" value="Azure Key Vault + Managed Identity per app (stage 10)&lt;br&gt;token signing key · CloudAMQP URL · Grafana Cloud token&lt;br&gt;PostgreSQL via Entra ID (stage 10)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2311.9" y="255.7" width="304.0" height="48.5" as="geometry"/></mxCell><mxCell id="c22" value="&lt;B&gt;Development, tests and delivery&lt;/B&gt;" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1071.3" y="911.4" width="183.2" height="36.0" as="geometry"/></mxCell><mxCell id="c23" value="Single-host topology — SmartSpare.Host&lt;br&gt;HTTP API + BFF: /bff sign-in, HttpOnly cookie, antiforgery, strict CSP&lt;br&gt;hosts the WASM client · all six modules in one process&lt;br&gt;in-process events and Contracts queries · used locally, in tests and CI" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1229.8" y="1123.9" width="348.2" height="62.0" as="geometry"/></mxCell><mxCell id="c24" value=".NET Aspire AppHost (local only)&lt;br&gt;PostgreSQL 17 container · telemetry dashboard&lt;br&gt;--topology services: gateway, six services, RabbitMQ or CloudAMQP,&lt;br&gt;Collector · Prometheus · Loki · Tempo · Grafana (self-hosted),&lt;br&gt;optionally also exporting to Grafana Cloud" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1082.3" y="997.9" width="345.2" height="75.5" as="geometry"/></mxCell><mxCell id="c25" value="SmartSpare.MigrationRunner&lt;br&gt;bootstrap + EF migrations in ModuleCatalog order&lt;br&gt;check-model · used by Aspire and CI" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="951.9" y="1130.7" width="256.0" height="48.5" as="geometry"/></mxCell><mxCell id="c26" value="GitHub Actions CI (tools/check.sh)&lt;br&gt;build · format · check-model · tests · coverage and vulnerability gates&lt;br&gt;SQL suite on the EF-built database · topology test&lt;br&gt;Playwright smoke test in Chromium · container images" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;fontSize=10;" vertex="1" parent="1"><mxGeometry x="715.3" y="1004.7" width="345.2" height="62.0" as="geometry"/></mxCell><mxCell id="c27" value="Per-service deploy workflows (first run: stage 10)&lt;br&gt;OIDC · image → Azure Container Registry&lt;br&gt;→ MigrationRunner job for the module (ADR 0020) → new revision" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#555555;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="591.6" y="1130.7" width="338.5" height="48.5" as="geometry"/></mxCell><mxCell id="c28" value="starts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;" edge="1" parent="1" source="c24" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="runs before the host" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="runs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;" edge="1" parent="1" source="c26" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="when green" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;" edge="1" parent="1" source="c7" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="REST/JSON + HttpOnly cookie" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="/api/v1/{module} + internal token&lt;br&gt; /internal credential checks → identity" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="CSV upload (stage 5)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c8" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="AMQPS: publish with confirms&lt;br&gt; consume into inbox" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="login per service" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;" edge="1" parent="1" source="c14" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c15" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c39" value="PO export (stage 7)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c14" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="models (stage 8)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c14" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c41" value="secrets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c13" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c42" value="OTLP (production: direct export;&lt;br&gt; locally through the collector)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;" edge="1" parent="1" source="c14" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c43" value="alerts (e-mail tested)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;" edge="1" parent="1" source="c17" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c27" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c45" value="migrations" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;" edge="1" parent="1" source="c25" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c46" value="smartspare_api" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;" edge="1" parent="1" source="c23" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
