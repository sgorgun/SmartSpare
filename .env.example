# Local development settings. Copy to .env (gitignored) and choose your own values:
#   cp .env.example .env
# Read by docker compose and by the db/ scripts (db/scripts/env.sh). Never commit .env.
# Azure takes these secrets from Key Vault / Managed Identity, not from this file.

# Superuser of the local PostgreSQL container (docker-compose.yml). Development only.
POSTGRES_PASSWORD=change-me-postgres

# Login roles created by db/bootstrap/000_bootstrap_cluster.sql (stored as SCRAM-SHA-256).
SMARTSPARE_MIGRATOR_PASSWORD=change-me-migrator
SMARTSPARE_API_PASSWORD=change-me-api
SMARTSPARE_JOBS_PASSWORD=change-me-jobs
SMARTSPARE_REPORTING_PASSWORD=change-me-reporting

# Password of the synthetic demo users of db/testdata/T001 (e.g. tomas.radzevicius, mantas.petrauskas).
# Choose any value: db/scripts/load_testdata.sh hashes it at load time (MigrationRunner set-demo-passwords).
# Demo data only.
SMARTSPARE_DEMO_USER_PASSWORD=change-me-demo
