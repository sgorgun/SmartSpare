{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jobs": {
    "Enabled": true,
    "Schedules": {
      "inventory.reservation-expiry": "0 0/15 * * * ?",
      "outbox-retention": "0 30 3 * * ?"
    }
  },
  "Messaging": {
    "Retention": {
      "OutboxDays": 7,
      "InboxDays": 30,
      "BatchSize": 5000
    }
  }
}
