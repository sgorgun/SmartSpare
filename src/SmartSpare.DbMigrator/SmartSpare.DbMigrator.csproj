<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- check nuget.org for the latest 10.x version -->
    <PackageReference Include="Npgsql" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The SQL files in /db are the single source of truth; they are embedded, not copied. -->
    <EmbeddedResource Include="..\..\db\migrations\V*.sql" LogicalName="migrations/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\db\seed\R*.sql" LogicalName="seed/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
