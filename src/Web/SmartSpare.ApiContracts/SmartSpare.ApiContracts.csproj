<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Public HTTP contract shared by the host, the modules and the Blazor client (ADR 0006, ADR 0014):
    DTOs, FluentValidation validators, and the role, claim, policy and problem-code names.
    Must never reference module projects, and depends only on FluentValidation and
    Microsoft.AspNetCore.Authorization (architecture test), so it also runs in WebAssembly.
  -->

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.AspNetCore.Authorization" />
  </ItemGroup>

</Project>
