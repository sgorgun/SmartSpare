@inject IStringLocalizer<SharedResource> Text

@* The editing panel every catalogue shares (ADR 0025): the catalogue's fields as child content, the error as a plain sentence, Save and Cancel. *@
<MudPaper Outlined="true" Class="pa-4 mb-4" data-testid="catalog-editor" role="region" aria-label="@Title">
    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">@Title</MudText>
    @ChildContent
    @if (Notice is not null)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2" data-testid="catalog-editor-notice">@Notice</MudAlert>
    }
    @if (Error is not null)
    {
        <MudText Color="Color.Error" Typo="Typo.body2" Class="mt-2" role="alert" data-testid="catalog-editor-error">@Error</MudText>
    }
    <div class="mt-3">
        <MudButton OnClick="OnSave" Disabled="Busy" Variant="Variant.Filled" Color="Color.Primary" Class="touch-target" data-testid="catalog-save">@Text["Catalog.Save"]</MudButton>
        <MudButton OnClick="OnCancel" Disabled="Busy" Variant="Variant.Text" Class="ml-2 touch-target" data-testid="catalog-cancel">@Text["Catalog.Cancel"]</MudButton>
    </div>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>The refusal of the last save, as a sentence with its reference.</summary>
    [Parameter]
    public string? Error { get; set; }

    /// <summary>Information such as "someone changed this record; the form shows their version".</summary>
    [Parameter]
    public string? Notice { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public EventCallback OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }
}
