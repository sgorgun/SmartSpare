@using SmartSpare.ApiContracts.MasterData
@inject CatalogClient Catalog

@* Picks an active catalogue entry for a document field (ADR 0025): searches the lookup endpoint as the user types.
   MudAutocomplete gives keyboard navigation and the combobox role for screen readers; archived entries never appear. *@
<MudAutocomplete T="CatalogLookupItem" Value="Value" ValueChanged="ValueChanged" SearchFunc="SearchAsync" ToStringFunc="Display"
                 Label="@Label" HelperText="@HelperText" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                 ResetValueOnEmptyText="true" DebounceInterval="300" MinCharacters="0" Required="Required" Disabled="Disabled"
                 aria-label="@Label" data-testid="@TestId">
    <ItemTemplate>
        <MudText Typo="Typo.body2"><strong>@context.Code</strong> — @context.Name</MudText>
        @if (!string.IsNullOrWhiteSpace(context.Detail))
        {
            <MudText Typo="Typo.caption">@context.Detail</MudText>
        }
    </ItemTemplate>
</MudAutocomplete>

@code {
    [Parameter, EditorRequired]
    public string Route { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string? HelperText { get; set; }

    [Parameter]
    public CatalogLookupItem? Value { get; set; }

    [Parameter]
    public EventCallback<CatalogLookupItem?> ValueChanged { get; set; }

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string TestId { get; set; } = "catalog-autocomplete";

    private async Task<IEnumerable<CatalogLookupItem>> SearchAsync(string? text, CancellationToken cancellationToken)
    {
        var result = await Catalog.LookupAsync(Route, text, cancellationToken);
        return result.IsSuccess ? result.Value! : [];
    }

    private static string Display(CatalogLookupItem? item) => item is null ? string.Empty : $"{item.Code} — {item.Name}";
}
