@page "/inventory/manufacturers"
@attribute [Authorize(Policy = Permissions.Inventory.Manufacturer.View)]
@using SmartSpare.ApiContracts.Inventory
@using SmartSpare.Web.Client.Features.MasterData
@inject IStringLocalizer<SharedResource> Text
@inject CatalogClient Catalog
@inject ProblemMessages Messages
@inject ISnackbar Snackbar
@inject IAuthorizationService Authorization

<PageTitle>@Text["Manufacturers.Title"]</PageTitle>

<InventoryTabs />
<CatalogPage @ref="_page" TItem="ManufacturerDto" Route="@Route" Title="@Text["Manufacturers.Title"]" Intro="@Text["Manufacturers.Intro"]"
             NewLabel="@Text["Manufacturers.New"]" MayEdit="_mayEdit" OnEdit="StartEdit" HasCsv="true"
             IdOf="b => b.Id" NameOf="b => b.Name" VersionOf="b => b.Version" IsArchivedOf="b => b.IsArchived">
    <Columns>
        <PropertyColumn T="ManufacturerDto" TProperty="string" Property="b => b.Code" Title="@Text["Manufacturers.Code"]" />
        <PropertyColumn T="ManufacturerDto" TProperty="string" Property="b => b.Name" Title="@Text["Manufacturers.Name"]" />
        <PropertyColumn T="ManufacturerDto" TProperty="string" Property="b => b.CountryCode ?? string.Empty" Title="@Text["Manufacturers.Country"]" />
        <PropertyColumn T="ManufacturerDto" TProperty="string" Property="b => b.Website ?? string.Empty" Title="@Text["Manufacturers.Website"]" />
    </Columns>
    <Editor>
        @if (_form is not null)
        {
            <CatalogEditor Title="@(_form.Id is null ? Text["Manufacturers.New"] : Text["Manufacturers.Edit", _form.Code ?? string.Empty])"
                           Error="@_formError" Notice="@_notice" Busy="_busy" OnSave="SaveAsync" OnCancel="() => _form = null">
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="3">
                        <MudTextField T="string" @bind-Value="_form.Code" Label="@Text["Manufacturers.Code"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Disabled="_form.Id is not null" HelperText="@Text["Manufacturers.CodeHelp"]" data-testid="manufacturer-code" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" @bind-Value="_form.Name" Label="@Text["Manufacturers.Name"]" Variant="Variant.Outlined" Margin="Margin.Dense" data-testid="manufacturer-name" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudTextField T="string" @bind-Value="_form.CountryCode" Label="@Text["Manufacturers.Country"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      HelperText="@Text["Manufacturers.CountryHelp"]" data-testid="manufacturer-country" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField T="string" @bind-Value="_form.Website" Label="@Text["Manufacturers.Website"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      InputType="InputType.Url" data-testid="manufacturer-website" />
                    </MudItem>
                </MudGrid>
            </CatalogEditor>
            @if (_form.Id is { } id)
            {
                <ResponsiblesPanel Segment="manufacturers" Kind="manufacturer" RecordId="id" RecordName="@(_form.Name ?? string.Empty)" />
            }
        }
    </Editor>
</CatalogPage>

@code {
    private const string Route = "api/v1/inventory/manufacturers";

    private CatalogPage<ManufacturerDto>? _page;
    private ManufacturerForm? _form;
    private string? _formError;
    private string? _notice;
    private bool _busy;
    private bool _mayEdit;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (AuthenticationState is not null)
        {
            _mayEdit = (await Authorization.AuthorizeAsync((await AuthenticationState).User, Permissions.Inventory.Manufacturer.Edit)).Succeeded;
        }
    }

    private void StartEdit(ManufacturerDto? manufacturer)
    {
        _formError = null;
        _notice = null;
        _form = manufacturer is null ? new ManufacturerForm() : ManufacturerForm.From(manufacturer);
    }

    private async Task SaveAsync()
    {
        if (_form is not { } form)
        {
            return;
        }

        var body = new ManufacturerWrite(form.Code ?? string.Empty, form.Name ?? string.Empty, form.CountryCode, form.Website);
        var validation = new ManufacturerWriteValidator().Validate(body);
        if (!validation.IsValid)
        {
            _formError = string.Join(" ", validation.Errors.Select(e => e.ErrorMessage));
            return;
        }

        _busy = true;
        var result = form.Id is { } id
            ? await Catalog.UpdateAsync<ManufacturerWrite, ManufacturerDto>(Route, id, body, form.Version!)
            : await Catalog.CreateAsync<ManufacturerWrite, ManufacturerDto>(Route, body);
        _busy = false;
        if (result.IsSuccess)
        {
            Snackbar.Add(Text["Manufacturers.Saved", result.Value!.Name], Severity.Success);
            _form = null;
            await _page!.ReloadAsync();
            return;
        }

        // 409 on an edit: someone changed the manufacturer since it was read. Show their version and say so; the user decides.
        if (result.Problem!.Status == 409 && form.Id is { } changedId && await Catalog.GetAsync<ManufacturerDto>(Route, changedId) is { IsSuccess: true } current)
        {
            _form = ManufacturerForm.From(current.Value!);
            _formError = null;
            _notice = Text["Catalog.ChangedMeanwhile"];
            return;
        }

        _formError = Messages.Describe(result.Problem);
    }

    private sealed class ManufacturerForm
    {
        public short? Id { get; init; }

        public string? Code { get; set; }

        public string? Name { get; set; }

        public string? CountryCode { get; set; }

        public string? Website { get; set; }

        public string? Version { get; init; }

        public static ManufacturerForm From(ManufacturerDto manufacturer) => new()
        {
            Id = manufacturer.Id, Code = manufacturer.Code, Name = manufacturer.Name, CountryCode = manufacturer.CountryCode, Website = manufacturer.Website, Version = manufacturer.Version,
        };
    }
}
