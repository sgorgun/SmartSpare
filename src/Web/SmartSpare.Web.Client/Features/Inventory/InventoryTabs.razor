@inject IStringLocalizer<SharedResource> Text
@inject NavigationManager Navigation
@inject IAuthorizationService Authorization

@* The pages of the Inventory area. Only pages that exist are linked, so main stays demo-ready. *@
<MudToolBar Dense="true" Gutters="false" Class="mb-3 flex-wrap" aria-label="@Text["Inventory.Pages"]">
    @foreach (var (href, key, icon, _) in Pages.Where(p => p.Policy is null || _allowed.Contains(p.Policy)))
    {
        var current = IsCurrent(href);
        <MudButton Href="@href" Variant="@(current ? Variant.Filled : Variant.Text)" Color="Color.Primary" StartIcon="@icon"
                   Class="mr-2 mb-1" aria-current="@(current ? "page" : null)">@Text[key]</MudButton>
    }
</MudToolBar>

@code {
    private static readonly (string Href, string Key, string Icon, string? Policy)[] Pages =
    [
        ("inventory", "Inventory.Tab.Parts", Icons.Material.Filled.Category, null),
        ("inventory/stock", "Inventory.Tab.Stock", Icons.Material.Filled.Warehouse, null),
        ("inventory/transfers", "Inventory.Tab.Transfers", Icons.Material.Filled.LocalShipping, null),
        ("inventory/imports", "Inventory.Tab.Imports", Icons.Material.Filled.UploadFile, Permissions.Inventory.Import.View),
        ("inventory/adjustment-reasons", "Inventory.Tab.AdjustmentReasons", Icons.Material.Filled.Rule, null),
    ];

    private readonly HashSet<string> _allowed = [];

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _allowed.Clear();
        if (AuthenticationState is null)
        {
            return;
        }

        var user = (await AuthenticationState).User;
        foreach (var policy in Pages.Select(p => p.Policy).OfType<string>().Distinct())
        {
            if ((await Authorization.AuthorizeAsync(user, policy)).Succeeded)
            {
                _allowed.Add(policy);
            }
        }
    }

    private bool IsCurrent(string href)
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].TrimEnd('/');
        return href == "inventory" ? path == "inventory" : path == href || path.StartsWith(href + "/", StringComparison.Ordinal);
    }
}
