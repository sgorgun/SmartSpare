@inject IStringLocalizer<SharedResource> Text
@inject NavigationManager Navigation

@* The pages of the Inventory area. Only pages that exist are linked, so main stays demo-ready. *@
<MudToolBar Dense="true" Gutters="false" Class="mb-3 flex-wrap" aria-label="@Text["Inventory.Pages"]">
    @foreach (var (href, key, icon) in Pages)
    {
        var current = IsCurrent(href);
        <MudButton Href="@href" Variant="@(current ? Variant.Filled : Variant.Text)" Color="Color.Primary" StartIcon="@icon"
                   Class="mr-2 mb-1" aria-current="@(current ? "page" : null)">@Text[key]</MudButton>
    }
</MudToolBar>

@code {
    private static readonly (string Href, string Key, string Icon)[] Pages =
    [
        ("inventory", "Inventory.Tab.Parts", Icons.Material.Filled.Category),
        ("inventory/stock", "Inventory.Tab.Stock", Icons.Material.Filled.Warehouse),
        ("inventory/transfers", "Inventory.Tab.Transfers", Icons.Material.Filled.LocalShipping),
    ];

    private bool IsCurrent(string href)
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].TrimEnd('/');
        return href == "inventory" ? path == "inventory" : path == href || path.StartsWith(href + "/", StringComparison.Ordinal);
    }
}
