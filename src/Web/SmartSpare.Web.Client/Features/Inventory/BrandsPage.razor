@page "/inventory/brands"
@attribute [Authorize(Policy = Permissions.Inventory.Brand.View)]
@using SmartSpare.ApiContracts.Inventory
@using SmartSpare.Web.Client.Features.MasterData
@inject IStringLocalizer<SharedResource> Text
@inject CatalogClient Catalog
@inject ProblemMessages Messages
@inject ISnackbar Snackbar
@inject IAuthorizationService Authorization

<PageTitle>@Text["Brands.Title"]</PageTitle>

<InventoryTabs />
<CatalogPage @ref="_page" TItem="BrandDto" Route="@Route" Title="@Text["Brands.Title"]" Intro="@Text["Brands.Intro"]"
             NewLabel="@Text["Brands.New"]" MayEdit="_mayEdit" OnEdit="StartEdit" HasCsv="true"
             IdOf="b => b.Id" NameOf="b => b.Name" VersionOf="b => b.Version" IsArchivedOf="b => b.IsArchived">
    <Columns>
        <PropertyColumn T="BrandDto" TProperty="string" Property="b => b.Code" Title="@Text["Brands.Code"]" />
        <PropertyColumn T="BrandDto" TProperty="string" Property="b => b.Name" Title="@Text["Brands.Name"]" />
        <PropertyColumn T="BrandDto" TProperty="string" Property="b => b.CountryCode" Title="@Text["Brands.Country"]" />
    </Columns>
    <Editor>
        @if (_form is not null)
        {
            <CatalogEditor Title="@(_form.Id is null ? Text["Brands.New"] : Text["Brands.Edit", _form.Code ?? string.Empty])"
                           Error="@_formError" Notice="@_notice" Busy="_busy" OnSave="SaveAsync" OnCancel="() => _form = null">
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="3">
                        <MudTextField T="string" @bind-Value="_form.Code" Label="@Text["Brands.Code"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Disabled="_form.Id is not null" HelperText="@Text["Brands.CodeHelp"]" data-testid="brand-code" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" @bind-Value="_form.Name" Label="@Text["Brands.Name"]" Variant="Variant.Outlined" Margin="Margin.Dense" data-testid="brand-name" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudTextField T="string" @bind-Value="_form.CountryCode" Label="@Text["Brands.Country"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      HelperText="@Text["Brands.CountryHelp"]" data-testid="brand-country" />
                    </MudItem>
                </MudGrid>
            </CatalogEditor>
        }
    </Editor>
</CatalogPage>

@code {
    private const string Route = "api/v1/inventory/brands";

    private CatalogPage<BrandDto>? _page;
    private BrandForm? _form;
    private string? _formError;
    private string? _notice;
    private bool _busy;
    private bool _mayEdit;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (AuthenticationState is not null)
        {
            _mayEdit = (await Authorization.AuthorizeAsync((await AuthenticationState).User, Permissions.Inventory.Brand.Edit)).Succeeded;
        }
    }

    private void StartEdit(BrandDto? brand)
    {
        _formError = null;
        _notice = null;
        _form = brand is null ? new BrandForm() : BrandForm.From(brand);
    }

    private async Task SaveAsync()
    {
        if (_form is not { } form)
        {
            return;
        }

        var body = new BrandWrite(form.Code ?? string.Empty, form.Name ?? string.Empty, form.CountryCode ?? string.Empty);
        var validation = new BrandWriteValidator().Validate(body);
        if (!validation.IsValid)
        {
            _formError = string.Join(" ", validation.Errors.Select(e => e.ErrorMessage));
            return;
        }

        _busy = true;
        var result = form.Id is { } id
            ? await Catalog.UpdateAsync<BrandWrite, BrandDto>(Route, id, body, form.Version!)
            : await Catalog.CreateAsync<BrandWrite, BrandDto>(Route, body);
        _busy = false;
        if (result.IsSuccess)
        {
            Snackbar.Add(Text["Brands.Saved", result.Value!.Name], Severity.Success);
            _form = null;
            await _page!.ReloadAsync();
            return;
        }

        // 409 on an edit: someone changed the brand since it was read. Show their version and say so; the user decides.
        if (result.Problem!.Status == 409 && form.Id is { } changedId && await Catalog.GetAsync<BrandDto>(Route, changedId) is { IsSuccess: true } current)
        {
            _form = BrandForm.From(current.Value!);
            _formError = null;
            _notice = Text["Catalog.ChangedMeanwhile"];
            return;
        }

        _formError = Messages.Describe(result.Problem);
    }

    private sealed class BrandForm
    {
        public short? Id { get; init; }

        public string? Code { get; set; }

        public string? Name { get; set; }

        public string? CountryCode { get; set; }

        public string? Version { get; init; }

        public static BrandForm From(BrandDto brand) => new()
        {
            Id = brand.Id, Code = brand.Code, Name = brand.Name, CountryCode = brand.CountryCode, Version = brand.Version,
        };
    }
}
