@inject IStringLocalizer<SharedResource> Text
@inject NavigationManager Navigation

@* The pages of the Fleet area. Only pages that exist are linked, so main stays demo-ready. *@
@* A wrapping row instead of a fixed-height toolbar: on a phone the tabs take two lines without covering the heading. *@
<nav class="d-flex flex-wrap mb-3" aria-label="@Text["Fleet.Pages"]">
    @foreach (var (href, key, icon) in Pages)
    {
        var current = IsCurrent(href);
        <MudButton Href="@href" Variant="@(current ? Variant.Filled : Variant.Text)" Color="Color.Primary" StartIcon="@icon"
                   Class="mr-2 mb-1 touch-target" aria-current="@(current ? "page" : null)">@Text[key]</MudButton>
    }
</nav>

@code {
    private static readonly (string Href, string Key, string Icon)[] Pages =
    [
        ("fleet/machines", "Fleet.Tab.Machines", Icons.Material.Filled.Agriculture),
        ("fleet/maintenance", "Fleet.Tab.Due", Icons.Material.Filled.EventNote),
        ("fleet/service-orders", "Fleet.Tab.Orders", Icons.Material.Filled.Build),
    ];

    private bool IsCurrent(string href)
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].TrimEnd('/');
        return path == href || path.StartsWith(href + "/", StringComparison.Ordinal) || (href == "fleet/machines" && path == "fleet");
    }
}
