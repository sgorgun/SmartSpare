@page "/account/password"
@attribute [Authorize]
@using SmartSpare.ApiContracts.Identity
@inject IStringLocalizer<SharedResource> Text
@inject IdentityClient Identity
@inject ProblemMessages Messages
@inject NavigationManager Navigation

<PageTitle>@Text["Password.Title"]</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-3">@Text["Password.Title"]</MudText>

<MudPaper Outlined="true" Class="pa-4" Style="max-width: 32rem" data-testid="password-form">
    <MudTextField T="string" @bind-Value="_current" Label="@Text["Password.Current"]" InputType="InputType.Password" Variant="Variant.Outlined"
                  Margin="Margin.Dense" Class="mb-2" data-testid="current-password" autocomplete="current-password" />
    <MudTextField T="string" @bind-Value="_new" Label="@Text["Password.New"]" InputType="InputType.Password" Variant="Variant.Outlined"
                  Margin="Margin.Dense" HelperText="@Text["Users.PasswordRule"]" Class="mb-2" data-testid="new-password" autocomplete="new-password" />
    @if (_error is not null)
    {
        <MudText Color="Color.Error" Typo="Typo.body2" Class="mb-2" data-testid="password-error">@_error</MudText>
    }
    <MudButton OnClick="ChangeAsync" Disabled="_busy" Variant="Variant.Filled" Color="Color.Primary" data-testid="change-password">@Text["Password.Change"]</MudButton>
    <MudText Typo="Typo.caption" Class="mt-2 d-block">@Text["Password.SignInAgain"]</MudText>
</MudPaper>

@code {
    private string? _current;
    private string? _new;
    private string? _error;
    private bool _busy;

    private async Task ChangeAsync()
    {
        var request = new ChangePasswordRequest(_current ?? string.Empty, _new ?? string.Empty);
        var validation = new ChangePasswordRequestValidator().Validate(request);
        if (!validation.IsValid)
        {
            _error = string.Join(" ", validation.Errors.Select(e => e.ErrorMessage));
            return;
        }

        _busy = true;
        var result = await Identity.ChangeOwnPasswordAsync(request);
        _busy = false;
        if (!result.IsSuccess)
        {
            _error = Messages.Describe(result.Problem!);
            return;
        }

        // Every session of the user ends with the rotated stamp: sign out and in again with the new password.
        await Identity.LogoutAsync();
        Navigation.NavigateTo(LoginLinks.LoginPath, forceLoad: true);
    }
}
