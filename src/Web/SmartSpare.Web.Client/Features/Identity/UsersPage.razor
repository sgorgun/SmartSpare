@page "/admin/users"
@attribute [Authorize(Policy = AppPolicies.Administration)]
@using System.Globalization
@using SmartSpare.ApiContracts.Identity
@inject IStringLocalizer<SharedResource> Text
@inject IdentityClient Identity
@inject ProblemMessages Messages
@inject ISnackbar Snackbar

<PageTitle>@Text["Users.Title"]</PageTitle>

<div class="d-flex align-center flex-wrap mb-2">
    <MudText Typo="Typo.h4" HtmlTag="h1" Class="mr-auto">@Text["Users.Title"]</MudText>
    <MudButton OnClick="StartCreate" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
               data-testid="new-user">@Text["Users.New"]</MudButton>
</div>

<MudTextField T="string" @bind-Value="_search" Label="@Text["Users.Search"]" Variant="Variant.Outlined" Margin="Margin.Dense"
              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" DebounceInterval="400"
              OnDebounceIntervalElapsed="SearchAsync" OnClearButtonClick="ClearAsync" InputMode="InputMode.search" Class="mb-3" />

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3" data-testid="users-error">@_error</MudAlert>
}

@if (_editing is not null && _options is not null)
{
    <MudPaper Outlined="true" Class="pa-4 mb-4" data-testid="user-form">
        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">@(_editing.Id is null ? Text["Users.New"] : Text["Users.EditAccess", _editing.UserName ?? string.Empty])</MudText>
        @if (_editing.Id is null)
        {
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="_editing.UserName" Label="@Text["Users.UserName"]" Variant="Variant.Outlined" Margin="Margin.Dense" data-testid="user-name" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="_editing.FullName" Label="@Text["Users.FullName"]" Variant="Variant.Outlined" Margin="Margin.Dense" data-testid="full-name" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="_editing.Email" Label="@Text["Users.Email"]" Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Email" data-testid="email" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="_editing.Password" Label="@Text["Users.InitialPassword"]" Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Password" HelperText="@Text["Users.PasswordRule"]" data-testid="password" /></MudItem>
            </MudGrid>
        }

        <MudText Typo="Typo.subtitle2" Class="mt-3">@Text["Users.Roles"]</MudText>
        <div class="d-flex flex-wrap" data-testid="role-choices">
            @foreach (var role in _options.Roles)
            {
                <MudCheckBox T="bool" Value="_editing.Roles.Contains(role)" ValueChanged="@(on => Toggle(_editing.Roles, role, on))" Label="@Text["Role." + role]" />
            }
        </div>

        @if (_editing.Roles.Contains(AppRoles.BrandManager))
        {
            <MudText Typo="Typo.subtitle2" Class="mt-2">@Text["Users.Brands"]</MudText>
            <div class="d-flex flex-wrap" data-testid="brand-choices">
                @foreach (var brand in _options.Brands)
                {
                    <MudCheckBox T="bool" Value="_editing.Brands.Contains(brand)" ValueChanged="@(on => Toggle(_editing.Brands, brand, on))" Label="@brand" />
                }
            </div>
        }

        <MudSelect T="short?" @bind-Value="_editing.HomeWarehouseId" Label="@Text["Users.HomeHub"]" Variant="Variant.Outlined" Dense="true" Class="mt-2" data-testid="home-hub">
            <MudSelectItem T="short?" Value="null">@Text["Users.NoHub"]</MudSelectItem>
            @foreach (var hub in _options.Hubs)
            {
                <MudSelectItem T="short?" Value="hub.Id">@hub.Code · @hub.Name</MudSelectItem>
            }
        </MudSelect>

        @if (_formError is not null)
        {
            <MudText Color="Color.Error" Typo="Typo.body2" Class="mt-2" data-testid="user-form-error">@_formError</MudText>
        }

        <div class="mt-3">
            <MudButton OnClick="SaveAsync" Disabled="_busy" Variant="Variant.Filled" Color="Color.Primary" data-testid="save-user">@Text["Users.Save"]</MudButton>
            <MudButton OnClick="() => _editing = null" Disabled="_busy" Variant="Variant.Text" Class="ml-2">@Text["Transfer.No"]</MudButton>
        </div>
    </MudPaper>
}

<MudDataGrid @ref="_grid" T="UserSummary" ServerData="LoadAsync" RowsPerPage="UserLimits.DefaultPageSize" Dense="true" Outlined="true" Elevation="0"
             Breakpoint="Breakpoint.Sm" SortMode="SortMode.None" Filterable="false" data-testid="users-grid">
    <Columns>
        <PropertyColumn Property="u => u.UserName" Title="@Text["Users.UserName"]" />
        <PropertyColumn Property="u => u.FullNameMasked" Title="@Text["Users.FullName"]" />
        <TemplateColumn Title="@Text["Users.Roles"]">
            <CellTemplate>@string.Join(", ", context.Item.Roles.Select(r => Text["Role." + r].Value))@(context.Item.Brands.Count > 0 ? $" ({string.Join(", ", context.Item.Brands)})" : string.Empty)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@Text["Users.HomeHub"]">
            <CellTemplate>@HubCode(context.Item.HomeWarehouseId)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@Text["Stock.Status"]">
            <CellTemplate>
                @if (context.Item.IsAnonymised)
                {
                    <StatusChip Label="@Text["Users.Anonymised"]" Icon="@Icons.Material.Filled.PersonOff" Color="Color.Default" />
                }
                else if (!context.Item.IsActive)
                {
                    <StatusChip Label="@Text["Users.Inactive"]" Icon="@Icons.Material.Filled.Block" Color="Color.Warning" />
                }
                else if (context.Item.IsLockedOut)
                {
                    <StatusChip Label="@Text["Users.LockedOut"]" Icon="@Icons.Material.Filled.Lock" Color="Color.Error" />
                }
                else
                {
                    <StatusChip Label="@Text["Users.Active"]" Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="" CellClass="text-right">
            <CellTemplate>
                @if (!context.Item.IsAnonymised)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => StartEdit(context.Item)" data-testid="edit-user">@Text["Users.EditAccessShort"]</MudButton>
                    @if (context.Item.IsLockedOut)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => ActAsync(context.Item, UnlockAction)">@Text["Users.Unlock"]</MudButton>
                    }
                    @if (context.Item.IsActive)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning" OnClick="() => Confirm(context.Item, DeactivateAction)">@Text["Users.Deactivate"]</MudButton>
                    }
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => Confirm(context.Item, AnonymiseAction)">@Text["Users.Anonymise"]</MudButton>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent><MudText>@Text["Users.None"]</MudText></NoRecordsContent>
    <LoadingContent><MudText>@Text["Users.Loading"]</MudText></LoadingContent>
    <PagerContent><MudDataGridPager T="UserSummary" /></PagerContent>
</MudDataGrid>

@if (_confirm is { } pending)
{
    <MudPaper Outlined="true" Class="pa-4 mt-3" data-testid="user-confirm">
        <MudText Class="mb-2">@Text["Users.Confirm." + pending.Action, pending.User.UserName]</MudText>
        <MudButton OnClick="() => ActAsync(pending.User, pending.Action)" Disabled="_busy" Variant="Variant.Filled" Color="Color.Error" data-testid="confirm-user-action">@Text["Transfer.Yes"]</MudButton>
        <MudButton OnClick="() => _confirm = null" Variant="Variant.Text" Class="ml-2">@Text["Transfer.No"]</MudButton>
    </MudPaper>
}

@code {
    private const string UnlockAction = "unlock";
    private const string DeactivateAction = "deactivate";
    private const string AnonymiseAction = "anonymise";

    private MudDataGrid<UserSummary>? _grid;
    private UserFormOptions? _options;
    private string? _search;
    private string? _error;
    private string? _formError;
    private bool _busy;
    private UserForm? _editing;
    private (UserSummary User, string Action)? _confirm;

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        var options = await Identity.GetUserFormOptionsAsync();
        _options = options.IsSuccess ? options.Value : null;
        _error = options.IsSuccess ? null : Messages.Describe(options.Problem!);
    }

    private async Task<GridData<UserSummary>> LoadAsync(GridState<UserSummary> state, CancellationToken cancellationToken)
    {
        if (!RendererInfo.IsInteractive)
        {
            return new GridData<UserSummary> { Items = [], TotalItems = 0 };
        }

        var result = await Identity.ListUsersAsync(_search, state.Page + 1, state.PageSize, cancellationToken);
        if (!result.IsSuccess)
        {
            _error = Messages.Describe(result.Problem!);
            StateHasChanged();
            return new GridData<UserSummary> { Items = [], TotalItems = 0 };
        }

        return new GridData<UserSummary> { Items = result.Value!.Items, TotalItems = result.Value.TotalCount };
    }

    private void StartCreate()
    {
        _formError = null;
        _editing = new UserForm();
    }

    private void StartEdit(UserSummary user)
    {
        _formError = null;
        _editing = new UserForm
        {
            Id = user.Id,
            UserName = user.UserName,
            Roles = [.. user.Roles],
            Brands = [.. user.Brands],
            HomeWarehouseId = user.HomeWarehouseId,
        };
    }

    private async Task SaveAsync()
    {
        if (_editing is not { } form)
        {
            return;
        }

        var access = new UserAccessRequest(
            [.. form.Roles], form.Roles.Contains(AppRoles.BrandManager) ? [.. form.Brands] : [], form.HomeWarehouseId);
        _busy = true;
        try
        {
            if (form.Id is { } id)
            {
                _formError = Validate(new UserAccessRequestValidator(), access);
                if (_formError is null)
                {
                    var result = await Identity.UpdateUserAccessAsync(id, access);
                    _formError = result.IsSuccess ? null : Messages.Describe(result.Problem!);
                }
            }
            else
            {
                var request = new CreateUserRequest(form.UserName ?? string.Empty, form.Email ?? string.Empty, form.FullName ?? string.Empty, null,
                    form.Password ?? string.Empty, access);
                _formError = Validate(new CreateUserRequestValidator(), request);
                if (_formError is null)
                {
                    var result = await Identity.CreateUserAsync(request);
                    _formError = result.IsSuccess ? null : Messages.Describe(result.Problem!);
                }
            }
        }
        finally
        {
            _busy = false;
        }

        if (_formError is null)
        {
            Snackbar.Add(Text["Users.Saved"], Severity.Success);
            _editing = null;
            await ReloadAsync();
        }
    }

    private void Confirm(UserSummary user, string action) => _confirm = (user, action);

    private async Task ActAsync(UserSummary user, string action)
    {
        _busy = true;
        var result = await Identity.UserActionAsync(user.Id, action);
        _busy = false;
        _confirm = null;
        if (result.IsSuccess)
        {
            Snackbar.Add(Text["Users.Done." + action, user.UserName], Severity.Success);
            await ReloadAsync();
        }
        else
        {
            Snackbar.Add(Messages.Describe(result.Problem!), Severity.Error);
        }
    }

    private Task SearchAsync(string? _) => ReloadAsync();

    private Task ClearAsync(MouseEventArgs _)
    {
        _search = null;
        return ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (_grid is not null)
        {
            await _grid.ReloadServerData();
        }
    }

    private string HubCode(short? id) =>
        id is null ? string.Empty : _options?.Hubs.FirstOrDefault(h => h.Id == id)?.Code ?? id.Value.ToString(CultureInfo.InvariantCulture);

    private static void Toggle(List<string> values, string value, bool on)
    {
        values.Remove(value);
        if (on)
        {
            values.Add(value);
        }
    }

    /// <summary>The shared ApiContracts validator, so the form and the server agree.</summary>
    private static string? Validate<T>(FluentValidation.IValidator<T> validator, T request)
    {
        var result = validator.Validate(request);
        return result.IsValid ? null : string.Join(" ", result.Errors.Select(e => e.ErrorMessage));
    }

    private sealed class UserForm
    {
        public Guid? Id { get; init; }

        public string? UserName { get; set; }

        public string? FullName { get; set; }

        public string? Email { get; set; }

        public string? Password { get; set; }

        public List<string> Roles { get; init; } = [];

        public List<string> Brands { get; init; } = [];

        public short? HomeWarehouseId { get; set; }
    }
}
