<Project Sdk="Microsoft.NET.Sdk">

  <!-- Local development orchestration only; Azure is deployed with Bicep (ADR 0009). Aspire 17: a plain .NET
       project with the AppHost and Dotnet hosting packages; the dashboard and orchestrator come from the Aspire
       bundle (aspire.dev/integrations/dotnet/migrate-dotnet-project-resource). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>smartspare-apphost</UserSecretsId>
    <!-- No lock file: the AppHost packages resolve platform-specific assets for the build machine's RID
         (win-x64 locally, linux-x64 in CI), so one lock file cannot fit both. Acceptable because the
         AppHost is local-only and never deployed. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.Dotnet" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.OpenTelemetryCollector" />
  </ItemGroup>

</Project>
