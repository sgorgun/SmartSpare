<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Embeds db/sql/identity/*.sql for the module's migrations (Directory.Build.targets). -->
    <SmartSpareSqlFolder>identity</SmartSpareSqlFolder>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Data Protection key ring lives in iam.data_protection_keys (#22); the host decides to use it. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\SmartSpare.Infrastructure\SmartSpare.Infrastructure.csproj" />
    <ProjectReference Include="..\SmartSpare.Modules.Identity.Contracts\SmartSpare.Modules.Identity.Contracts.csproj" />
    <!-- Inventory events: brand and warehouse copies, responsibilities (ADR 0026, 0029). -->
    <ProjectReference Include="..\..\Inventory\SmartSpare.Modules.Inventory.Contracts\SmartSpare.Modules.Inventory.Contracts.csproj" />
    <!-- The public HTTP contract: claim types and role names (STAGE_3_PLAN S14, ADR 0014). -->
    <ProjectReference Include="..\..\..\Web\SmartSpare.ApiContracts\SmartSpare.ApiContracts.csproj" />
  </ItemGroup>

</Project>
