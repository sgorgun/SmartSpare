<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Backend for frontend (ADR 0014, ADR 0016): the /bff endpoints, the auth cookie with its session check,
    antiforgery, the sign-in rate limit, the internal-token issuer, and the hosting of the WebAssembly client
    (CSP, principal serialization, fallback policy). Used by SmartSpare.Host and SmartSpare.Gateway. It talks to Identity only through Identity.Contracts (architecture test).
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <!-- Serializes the allow-listed principal to the WebAssembly client; both BFF hosts serve the client. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartSpare.Infrastructure\SmartSpare.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Web\SmartSpare.ApiContracts\SmartSpare.ApiContracts.csproj" />
    <ProjectReference Include="..\..\Modules\Identity\SmartSpare.Modules.Identity.Contracts\SmartSpare.Modules.Identity.Contracts.csproj" />
  </ItemGroup>

</Project>
