<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Embeds db/sql/platform/*.sql for the PlatformDbContext migrations (Directory.Build.targets). -->
    <SmartSpareSqlFolder>platform</SmartSpareSqlFolder>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Scrutor" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <!-- Pins the EF Core patch of every module (Directory.Packages.props). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- Validation of internal tokens (ADR 0016): the single host now, every service host in stage 4. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartSpare.SharedKernel\SmartSpare.SharedKernel.csproj" />
    <!-- Claim types, roles and problem codes of the public HTTP contract (ADR 0014). -->
    <ProjectReference Include="..\..\Web\SmartSpare.ApiContracts\SmartSpare.ApiContracts.csproj" />
  </ItemGroup>

</Project>
