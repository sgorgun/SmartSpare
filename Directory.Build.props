<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <IsPackable>false</IsPackable>
    <Deterministic>true</Deterministic>
    <!-- packages.lock.json pins the full transitive graph; CI restores with locked mode. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- Each production project exposes its internals to its own unit- and integration-test projects only. -->
  <ItemGroup Condition="!$(MSBuildProjectName.EndsWith('Tests'))">
    <InternalsVisibleTo Include="$(MSBuildProjectName).UnitTests" />
    <InternalsVisibleTo Include="$(MSBuildProjectName).IntegrationTests" />
  </ItemGroup>

  <!--
    Static analysis (#61, STAGE_5_PLAN section 10): the SonarQube C# rules as a NuGet analyzer in every production
    project, under TreatWarningsAsErrors like the .NET analyzers. Rules that conflict with the codebase's conventions
    are switched off in .editorconfig with a reason.
  -->
  <ItemGroup Condition="!$(MSBuildProjectName.EndsWith('Tests')) And '$(MSBuildProjectName)' != 'SmartSpare.E2E'">
    <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
  </ItemGroup>
</Project>
